# ─── Copy this file to ".env" and fill in real values. NEVER commit .env to GitHub. ───

# App
PORT=3000
NODE_ENV=development
SESSION_SECRET=change_this_to_a_long_random_string

# PostgreSQL connection string (from Neon / Supabase / local)
# Example: postgresql://user:password@host:5432/sampaguita
DATABASE_URL=

# Semaphore SMS API  (https://semaphore.co -> dashboard -> API)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER=          # leave blank until your Sender ID is approved (2-4 wk wait)

# Email (SMTP) — Brevo or Gmail. For Gmail use an App Password, not your real password.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sampaguita Health Clinic <noreply@example.com>"

# Reminders
REMINDER_CRON=0 8 * * *    # every day at 8:00 AM (Asia/Manila)
REMINDER_LEAD_DAYS=1       # remind this many days BEFORE the appointment (1 = the day before)
LOW_CREDIT_ALERT=100       # alert admin when SMS credits drop below this
CRON_SECRET=change_this_to_a_long_random_token   # token for /tasks/run-reminders (cron-job.org)
