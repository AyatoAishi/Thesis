# ─── Copy this file to ".env" and fill in real values. NEVER commit .env to GitHub. ───

# App
PORT=3000
NODE_ENV=development
SESSION_SECRET=change_this_to_a_long_random_string

# PostgreSQL connection string (from Neon / Supabase / local)
# Example: postgresql://user:password@host:5432/sampaguita
DATABASE_URL=

# SMS - no provider connected. Set ONE pair and restart; nothing else changes.
# PhilSMS is the one being evaluated (Semaphore was priced out at ~P0.50/text).
PHILSMS_TOKEN=
PHILSMS_SENDER=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER=          # a Sender ID takes 2-4 weeks to approve

# ---- EMAIL -------------------------------------------------------------------
# Two ways out, and the app picks whichever is configured:
#
#   BREVO_API_KEY set          -> Brevo's HTTP API, over port 443
#   SMTP_USER + SMTP_PASS set  -> ordinary SMTP
#   neither                    -> simulation; nothing is sent, everything logged
#
# USE THE API KEY IN PRODUCTION. Render blocks outbound SMTP, and it does it
# silently: between 2026-07-26 and 2026-08-19 every message from the live server
# failed with "Connection timeout" while the same credentials worked fine from a
# laptop. Port 443 is not blocked anywhere. SMTP is kept for local development.
#
# Get the key at Brevo -> Settings -> SMTP & API -> *API Keys* tab. The right one
# starts with `xkeysib-`; one starting with `xsmtpsib-` is the SMTP password from
# the neighbouring tab, and will not work from Render.
# Verify the MAIL_FROM address under Senders first, or Brevo rejects every send.
BREVO_API_KEY=

SMTP_HOST=smtp.gmail.com   # for Gmail use an App Password, not your real password
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# No quotes around this value. SMTP tolerates them; the HTTP API does not.
MAIL_FROM=Sampaguita Health Clinic <noreply@example.com>

# Reminders
REMINDER_CRON=0 8 * * *    # every day at 8:00 AM (Asia/Manila)
REMINDER_LEAD_DAYS=1       # remind this many days BEFORE the appointment (1 = the day before)
LOW_CREDIT_ALERT=100       # alert admin when SMS credits drop below this

# Base address used to build the patient password-reset link. Leave blank and the
# app works it out from the request, which is right in almost every case.
APP_URL=
CRON_SECRET=change_this_to_a_long_random_token   # token for /tasks/run-reminders (cron-job.org)
