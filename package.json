{
  "name": "sampaguita-clinic-system",
  "version": "0.1.0",
  "private": true,
  "description": "Web-Based EMR + Appointment System for Barangay Sampaguita Health Clinic (Group 7 thesis)",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k -n SERVER,CSS -c blue,magenta \"nodemon server.js\" \"npm:css:watch\"",
    "build": "npm run css",
    "css": "tailwindcss -i ./public/css/src.css -o ./public/css/app.css --minify",
    "css:watch": "tailwindcss -i ./public/css/src.css -o ./public/css/app.css --watch",
    "db:setup": "node db/migrate.js",
    "seed:admin": "node db/seed-admin.js",
    "seed:demo": "node db/seed-demo.js",
    "reminders:run": "node services/reminders.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.19.1",
    "pg": "^8.12.0",
    "tailwindcss": "^3.4.10"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4"
  }
}
