<div class="page-head">
  <h1>My account</h1>
  <div class="sub"><%= user.username %> · <%= user.role %></div>
</div>

<% if (notice) { %>
  <div class="card" style="border-color:var(--ok);background:var(--ok-bg)"><%= notice %></div>
<% } %>
<% if (errors && errors.length) { %>
  <div class="card" style="border-color:var(--bad);background:var(--bad-bg)">
    <ul style="margin:0;color:var(--bad-ink);font-size:13px">
      <% errors.forEach(e => { %><li><%= e %></li><% }) %>
    </ul>
  </div>
<% } %>

<div class="card">
  <div class="panel-title" style="margin-bottom:14px">Update profile</div>
  <form method="POST" action="/account/profile" class="form-grid"><%- include("partials/csrf") %>
    <label class="field"><span>Full name</span>
      <input type="text" name="full_name" value="<%= user.full_name %>" required />
    </label>
    <button type="submit" class="btn" style="align-self:flex-end">Save</button>
  </form>
</div>

<div class="card">
  <div class="panel-title" style="margin-bottom:4px">Change password</div>
  <% if (needsApproval) { %>
    <%# Said BEFORE the form, not after submitting it. Somebody who types a new
        password and is then told it will not work until tomorrow feels misled;
        somebody told first can decide whether to bother now. %>
    <p class="muted" style="font-size:12.5px;margin:0 0 12px">
      The admin approves every staff password change. Your current password keeps
      working until they do.
    </p>
  <% } else { %>
    <p class="muted" style="font-size:12.5px;margin:0 0 12px">Takes effect immediately.</p>
  <% } %>

  <% if (pendingPassword) { %>
    <div class="status-row" style="border:1px solid var(--warn);background:var(--warn-bg);border-radius:10px;padding:10px 12px;margin-bottom:12px">
      <div class="status-label">
        <b style="color:var(--warn-ink)">Waiting for the admin</b>
        <small>
          Requested <%= new Date(pendingPassword.requested_at).toLocaleString("en-PH", { timeZone: "Asia/Manila", month: "short", day: "numeric", hour: "numeric", minute: "2-digit" }) %>.
          Sending a new request replaces this one.
        </small>
      </div>
      <form method="POST" action="/account/password/cancel" style="margin:0"><%- include("partials/csrf") %>
        <button type="submit" class="mini-btn">Cancel request</button>
      </form>
    </div>
  <% } %>

  <form method="POST" action="/account/password" class="form-grid"><%- include("partials/csrf") %>
    <label class="field"><span>Current password</span>
      <%- include("partials/password-field", { name: "current_password", autocomplete: "current-password" }) %>
    </label>
    <label class="field"><span>New password</span>
      <%- include("partials/password-field", { name: "new_password", minlength: 8, autocomplete: "new-password" }) %>
    </label>
    <label class="field"><span>Confirm new password</span>
      <%- include("partials/password-field", { name: "confirm_password", minlength: 8, autocomplete: "new-password" }) %>
    </label>
    <button type="submit" class="btn" style="align-self:flex-end"><%= needsApproval ? "Send for approval" : "Change password" %></button>
  </form>
</div>
