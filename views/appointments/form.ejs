<%
  const isEdit = mode === "edit";
  const action = isEdit ? `/appointments/${appt.appointment_id}` : "/appointments";
  const chain = typeof next !== "undefined" ? next : "";
%>
<div class="page-head">
  <h1><%= isEdit ? "Reschedule appointment" : "Book appointment" %></h1>
  <div class="sub"><a href="/appointments" class="back-link">← Back to appointments</a></div>
</div>

<% if (errors && errors.length) { %>
  <div class="card" style="border-color:#f3c9cb;background:var(--bad-bg)">
    <b style="color:var(--bad-ink)">Please fix:</b>
    <ul style="margin:8px 0 0;color:var(--bad-ink);font-size:13px">
      <% errors.forEach(e => { %><li><%= e %></li><% }) %>
    </ul>
  </div>
<% } %>

<% if (chain === "book") { %>
  <%- include("../partials/flow-steps", { step: 3 }) %>
<% } %>

<form method="POST" action="<%= action %>"><%- include("../partials/csrf") %>
  <% if (chain) { %><input type="hidden" name="next" value="<%= chain %>" /><% } %>
  <%# overflow:visible so the patient picker's result list isn't clipped by
      .card's overflow-x. %>
  <div class="card" style="overflow:visible">
    <div class="form-grid">
      <label class="field" style="grid-column:1/-1"><span>Patient *</span>
        <% if (patient) { %>
          <input type="hidden" name="patient_id" value="<%= patient.patient_id %>" />
          <input type="text" value="<%= patient.full_name %> — <%= patient.patient_number %>" disabled />
        <% } else if (!patients.length) { %>
          <p class="muted" style="margin:6px 0 0">No patients registered yet. <a href="/patients/new">Add one first →</a></p>
        <% } else { %>
          <%- include("../partials/patient-picker", { patients, selectedId: appt.patient_id }) %>
          <script type="application/json" id="maleIds"><%- JSON.stringify(patients.filter(p => String(p.sex || "").toLowerCase() === "male").map(p => p.patient_id)) %></script>
        <% } %>
      </label>

      <%# The id of "other", so the notes field below can go from optional to
          required without hardcoding a number that a reseeded database would
          change underneath it. %>
      <% const otherSvc = services.find(s => s.name === "other"); %>
      <label class="field"><span>Service *</span>
        <select name="service_id" id="svcSelect" required
                data-other-id="<%= otherSvc ? otherSvc.service_id : '' %>">
          <option value="">— choose —</option>
          <%
            // "If the patient is male, there should be no way, in any way,
            // they can set an appointment for a prenatal." Not offered when the
            // patient is known here; disabled by the script when one is picked
            // below; refused by the server regardless (lib/booking.js).
            const knownMale = patient && String(patient.sex || "").toLowerCase() === "male";
          %>
          <% services.forEach(s => { %>
            <% if (knownMale && s.name === "prenatal") return; %>
            <option value="<%= s.service_id %>" data-svc="<%= s.name %>" <%= String(appt.service_id) === String(s.service_id) ? 'selected' : '' %>>
              <%= pretty(s.name) %>
            </option>
          <% }) %>
        </select>
      </label>

      <label class="field"><span>Date *</span>
        <input type="date" name="appointment_date" id="dateInput" value="<%= appt.appointment_date || '' %>" min="<%= today %>" required />
      </label>

      <%# A list of one-hour slots, not a free time box — 8 to 5, with lunch
          12–1 left out (lib/booking.js). Slots that have already ended today
          are disabled by the script below and refused by the server either way.
          A saved time that is not a slot (older bookings had 00:10, 19:58)
          still shows, marked, so rescheduling one is a choice rather than a
          silent change. %>
      <% const curTime = appt.appointment_time ? String(appt.appointment_time).slice(0, 5) : ""; %>
      <% const curIsSlot = slots.some(s => s.value === curTime); %>
      <label class="field"><span>Time slot *</span>
        <select name="appointment_time" id="slotSelect" required data-now="<%= nowHHMM %>" data-today="<%= today %>">
          <option value="">— choose a time —</option>
          <% if (curTime && !curIsSlot) { %>
            <option value="<%= curTime %>" selected><%= curTime %> — not a clinic slot, choose one below</option>
          <% } %>
          <% slots.forEach(s => { %>
            <option value="<%= s.value %>" data-end="<%= s.end %>" <%= curTime === s.value ? "selected" : "" %>><%= s.label %></option>
          <% }) %>
        </select>
        <span class="muted" style="font-size:12.5px;font-weight:500" data-slot-hint></span>
      </label>

      <label class="field" style="grid-column:1/-1">
        <span>Notes <span class="muted" data-notes-optional>(optional)</span></span>
        <input type="text" name="notes" value="<%= appt.notes || '' %>" maxlength="255"
               data-notes-input placeholder="e.g. BP check only — 130/80" />
        <%# Silent until "Other" is chosen, because that is the moment the word
            "optional" above stops being true. The server enforces it either
            way; this only stops somebody being told off after the fact. %>
        <span class="muted" style="font-size:11.5px;font-weight:500" data-notes-hint></span>
      </label>
    </div>
  </div>

  <button type="submit" class="btn"><%= isEdit ? "Save changes" : "Book appointment" %></button>
</form>

<script>
  // "Notes (optional)" stops being true the moment "Other" is the service, and
  // being told that only after pressing Save is a worse way to find out. The
  // server enforces it regardless — this is the courtesy, not the rule.
  (function () {
    var svc = document.getElementById("svcSelect");
    var notes = document.querySelector("[data-notes-input]");
    var word = document.querySelector("[data-notes-optional]");
    var hint = document.querySelector("[data-notes-hint]");
    if (!svc || !notes) return;
    var otherId = svc.getAttribute("data-other-id");
    function sync() {
      var isOther = otherId && svc.value === otherId;
      notes.required = !!isOther;
      if (word) word.textContent = isOther ? "(required)" : "(optional)";
      if (hint) hint.textContent = isOther
        ? "Sabihin kung ano ang ginawa — vitals, BP, palit ng benda. Ito lang ang record ng pagpuntang ito."
        : "";
      if (isOther) notes.setAttribute("aria-required", "true");
      else notes.removeAttribute("aria-required");
    }
    svc.addEventListener("change", sync);
    sync();
  })();
</script>

<script>
  // Slots that have already ended today are disabled, live — a form opened at
  // 9:55 and submitted at 10:05 should not still offer 9–10. Manila time is
  // read from the browser with an explicit timezone rather than the device's
  // own, which on a borrowed laptop may be anything.
  (function () {
    var sel = document.getElementById("slotSelect");
    var date = document.getElementById("dateInput");
    var hint = document.querySelector("[data-slot-hint]");
    if (!sel || !date) return;
    var today = sel.getAttribute("data-today");
    function manilaNow() {
      try {
        return new Intl.DateTimeFormat("en-GB", { timeZone: "Asia/Manila", hour: "2-digit", minute: "2-digit", hourCycle: "h23" })
          .format(new Date());
      } catch (e) { return sel.getAttribute("data-now"); }
    }
    function sync() {
      var now = manilaNow();
      var isToday = date.value === today;
      var closed = 0;
      Array.prototype.forEach.call(sel.options, function (o) {
        var end = o.getAttribute("data-end");
        if (!end) return;
        var over = isToday && end <= now;
        o.disabled = over;
        if (over) closed++;
        if (over && o.selected) sel.value = "";
      });
      if (hint) hint.textContent = isToday && closed
        ? closed + " slot" + (closed === 1 ? " has" : "s have") + " already ended today."
        : "";
    }
    date.addEventListener("change", sync);
    sync();
    setInterval(sync, 60000);
  })();

  // A male patient picked from the list: prenatal is disabled, and cleared if
  // it was already chosen.
  (function () {
    var svc = document.getElementById("svcSelect");
    var idsEl = document.getElementById("maleIds");
    var picker = document.querySelector("[data-picker-id]");
    if (!svc || !idsEl || !picker) return;
    var male = JSON.parse(idsEl.textContent || "[]").map(String);
    function sync() {
      var isMale = male.indexOf(String(picker.value)) !== -1;
      Array.prototype.forEach.call(svc.options, function (o) {
        if (o.getAttribute("data-svc") !== "prenatal") return;
        if (!o.hasAttribute("data-label")) o.setAttribute("data-label", o.textContent.trim());
        o.disabled = isMale;
        o.textContent = o.getAttribute("data-label") + (isMale ? " (not for a male patient)" : "");
        if (isMale && o.selected) svc.value = "";
      });
    }
    picker.addEventListener("change", sync);
    sync();
  })();
</script>
