<%
  function statusBadge(s) {
    const m = { scheduled:["info","Scheduled"], completed:["ok","Completed"], missed:["bad","Missed"], cancelled:["warn","Cancelled"] };
    const [c, l] = m[s] || ["info", s];
    return `<span class="badge ${c}">${l}</span>`;
  }
  const tabs = [["scheduled","Upcoming"],["completed","Completed"],["missed","Missed"],["cancelled","Cancelled"]];
%>
<div class="page-head" style="display:flex;align-items:center;justify-content:space-between">
  <div><h1>Appointments</h1><div class="sub">All bookings</div></div>
  <a class="btn" href="/appointments/new">+ Book appointment</a>
</div>

<div class="card">
  <div class="tabbar">
    <a href="/appointments" class="tab">Daily list</a>
    <% tabs.forEach(t => { %>
      <a href="/appointments/upcoming?status=<%= t[0] %>" class="tab <%= status === t[0] ? 'active' : '' %>"><%= t[1] %></a>
    <% }) %>
  </div>

  <% if (!rows.length) { %>
    <p class="muted" style="padding:8px 2px;margin:0">No <%= status %> appointments.</p>
  <% } else { %>
    <table class="tbl">
      <thead><tr><th>Date</th><th>Time</th><th>Patient</th><th>Service</th><th>Status</th></tr></thead>
      <tbody>
        <% rows.forEach(r => { %>
          <tr>
            <td><a href="/appointments?date=<%= r.appointment_date %>"><%= longDate(r.appointment_date) %></a></td>
            <td class="mono"><%= shortTime(r.appointment_time) || "—" %></td>
            <td>
              <a href="/patients/<%= r.patient_id %>"><%= r.full_name %></a>
              <span class="muted mono" style="font-size:11px"><%= r.patient_number %></span>
            </td>
            <td><%= pretty(r.service_name) %></td>
            <td><%- statusBadge(r.status) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
