<%
  const dateQ = date ? `&date=${date}` : "";
%>
<div class="page-head">
  <h1>Book appointment</h1>
  <div class="sub"><a href="/appointments" class="back-link">← Back to the schedule</a></div>
</div>

<div class="card">
  <div class="panel-title" style="margin-bottom:6px">Is this a new patient or an existing one?</div>
  <p class="muted" style="font-size:13px;margin:0 0 16px">
    Everyone who books needs a patient record first. If they've never been here before,
    we'll register them and set up their portal account on the way to the booking.
  </p>

  <div class="choice-grid">
    <a class="choice-card" href="/appointments/new?who=existing<%= dateQ %>">
      <span class="choice-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </span>
      <b>Existing patient</b>
      <span class="muted">They're already registered — search their name and book.</span>
    </a>

    <a class="choice-card" href="/patients/new?next=book">
      <span class="choice-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M20 8v6M23 11h-6"/></svg>
      </span>
      <b>New patient</b>
      <span class="muted">First visit — register them, set up the portal account, then book.</span>
    </a>
  </div>
</div>
