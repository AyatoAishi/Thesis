<%
  // The setup checklist that used to sit at the top of this page is gone. It
  // was a build-time tool — "paste your connection string into DATABASE_URL" —
  // shown to nurses and facilitators who have no .env, no terminal, and no way
  // to act on any of it. Two things were wrong with that: it made the first
  // screen of the day unreadable to the people who open it most, and it put
  // the shape of our infrastructure on a page anyone at the desk can see.
  // That checklist now lives on the Trello board instead.
  //
  // What replaced it is the same idea aimed at the clinic: the things that
  // need a person today. It reads res.locals.alerts, which server.js already
  // computed for the topbar bell on this very request — so this panel costs
  // no extra query, and it can never disagree with the bell.
  const attention = typeof alerts !== "undefined" ? alerts : [];

  const ICONS = {
    today_waiting: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    imm_overdue:   '<path d="M12 2v6M9 5h6"/><rect x="7" y="8" width="10" height="13" rx="2"/><path d="M10 13h4"/>',
    low_stock:     '<path d="M21 8V21H3V8"/><rect x="1" y="3" width="22" height="5" rx="1"/><path d="M10 12h4"/>',
  };
%>
<div class="page-head">
  <h1><%= t("dash.title") %></h1>
  <div class="sub"><%= today %></div>
</div>

<!-- Live metrics -->
<div class="stat-grid">
  <a class="stat-card" href="/appointments?date=<%= todayISO %>" style="text-decoration:none;color:inherit">
    <div class="stat-label"><%= t("dash.expected") %></div>
    <div class="stat-value"><%= stats ? stats.today : "—" %></div>
    <div class="stat-note"><%= t("dash.expected_sub") %></div>
  </a>
  <a class="stat-card" href="/patients" style="text-decoration:none;color:inherit">
    <div class="stat-label"><%= t("dash.patients") %></div>
    <div class="stat-value"><%= stats ? stats.patients : "—" %></div>
    <div class="stat-note"><%= t("dash.patients_sub") %></div>
  </a>
  <a class="stat-card" href="/appointments?date=<%= todayISO %>" style="text-decoration:none;color:inherit">
    <div class="stat-label"><%= t("dash.completed") %></div>
    <div class="stat-value"><%= stats ? stats.done : "—" %></div>
    <div class="stat-note"><%= t("dash.completed_sub") %></div>
  </a>
  <a class="stat-card" href="/appointments?date=<%= todayISO %>" style="text-decoration:none;color:inherit">
    <div class="stat-label"><%= t("dash.missed") %></div>
    <div class="stat-value"><%= stats ? stats.missed : "—" %></div>
    <div class="stat-note"><%= t("dash.missed_sub") %></div>
  </a>
</div>

<!-- Needs attention: only what this role can actually act on -->
<section class="card">
  <div class="panel-head">
    <div class="panel-title"><%= t("dash.attention") %></div>
  </div>
  <% if (attention.length) { %>
    <div class="status-list">
      <% attention.forEach(function (a) { %>
        <a class="status-row" href="<%= a.href %>" style="text-decoration:none;color:inherit">
          <div class="status-label" style="display:flex;align-items:center;gap:10px">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;color:var(--warn)">
              <%- ICONS[a.key] || '<circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/>' %>
            </svg>
            <span><%= a.label %></span>
          </div>
          <span class="badge warn"><%= t("dash.open") %></span>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <div class="status-list">
      <div class="status-row">
        <div class="status-label" style="display:flex;align-items:center;gap:10px">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;color:var(--ok)">
            <circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/>
          </svg>
          <span><%= t("dash.all_clear") %>
            <small><%= t("dash.all_clear_sub") %></small>
          </span>
        </div>
      </div>
    </div>
  <% } %>
</section>

<%# The calendar. This is a scheduling system whose front page had no calendar
    on it — the cards above say HOW MANY, and a clinic's actual question is
    WHEN. Niel asked for this and he was right.

    Days are links, not buttons, and the selection lives in the URL (?d=&m=).
    That is the same reasoning as the patient search: a GET is shareable, the
    Back button works through it, and a day can be bookmarked. Nothing here
    needs JavaScript to function. %>
<% if (calendar) { %>
<section class="card cal-card">
  <div class="panel-head">
    <div>
      <div class="panel-title"><%= t("dash.calendar") %></div>
      <div class="muted" style="font-size:12.5px;margin-top:3px">
        <%= t("dash.calendar_hint") %>
      </div>
    </div>
    <div class="cal-nav">
      <a class="mini-btn" href="/dashboard?m=<%= calendar.prev %>&d=<%= selected %>" aria-label="<%= t('dash.prev_month') %>">&larr;</a>
      <b class="cal-month"><%= calendar.label %></b>
      <a class="mini-btn" href="/dashboard?m=<%= calendar.next %>&d=<%= selected %>" aria-label="<%= t('dash.next_month') %>">&rarr;</a>
      <% if (calendar.key !== todayISO.slice(0, 7) || selected !== todayISO) { %>
        <a class="mini-btn" href="/dashboard"><%= t("dash.today") %></a>
      <% } %>
    </div>
  </div>

  <div class="cal-grid" role="grid" aria-label="<%= calendar.label %>">
    <% weekdays.forEach(function (w) { %>
      <div class="cal-head" role="columnheader"><%= w %></div>
    <% }) %>

    <% calendar.weeks.forEach(function (week) { %>
      <% week.forEach(function (c) { %>
        <% if (!c) { %>
          <%# Blank, not the neighbouring month's date. A greyed 30th sitting in
              October looks pressable and means nothing here. %>
          <div class="cal-cell is-empty" role="gridcell" aria-hidden="true"></div>
        <% } else { %>
          <a class="cal-cell<%= c.isToday ? " is-today" : "" %><%= c.isSelected ? " is-selected" : "" %><%= c.count ? " has-appts" : "" %><%= c.isPast ? " is-past" : "" %>"
             role="gridcell"
             href="/dashboard?m=<%= calendar.key %>&d=<%= c.date %>"
             aria-current="<%= c.isSelected ? "date" : "false" %>"
             <%
               // The hover text the review asked for. The same words go in
               // title= as well, which is what a long-press shows on a tablet.
               const cancelled = c.count - c.completed - c.missed - c.scheduled;
               const tip = c.count === 0 ? t("dash.tip_none")
                         : [c.completed && t("dash.tip_done", { n: c.completed }),
                            c.missed && t("dash.tip_missed", { n: c.missed }),
                            c.scheduled && t("dash.tip_booked", { n: c.scheduled }),
                            cancelled > 0 && t("dash.tip_cancelled", { n: cancelled })].filter(Boolean).join(" · ");
             %>
             data-tip="<%= tip %>" title="<%= tip %>"
             aria-label="<%= c.day %> — <%= tip %>">
            <span class="cal-day"><%= c.day %></span>
            <%# Numbers, not dots, each labelled with what it counts (Mr. Trapago;
                Richelle's Sept 26 scan). Sept 29: "2 appt, 2 missed" read as FOUR
                people, because the first chip was the day's total and the second
                was part of it. Now every chip counts different people, so they
                simply add up: done (came), missed (didn't), booked (still to
                come). Cancelled ones get no chip, only a word in the tooltip. The
                words drop on a phone, where the legend under the grid carries them. %>
            <% if (c.completed) { %>
              <span class="cal-count is-done"><%= c.completed %><span class="cal-word"> <%= t("dash.cell_done") %></span></span>
            <% } %>
            <% if (c.missed) { %>
              <span class="cal-count is-missed"><%= c.missed %><span class="cal-word"> <%= t("dash.cell_missed") %></span></span>
            <% } %>
            <% if (c.scheduled) { %>
              <span class="cal-count is-booked"><%= c.scheduled %><span class="cal-word"> <%= t("dash.cell_booked") %></span></span>
            <% } %>
          </a>
        <% } %>
      <% }) %>
    <% }) %>
  </div>
  <div class="cal-legend">
    <span><span class="cal-count is-done">2</span> <%= t("dash.legend_done") %></span>
    <span><span class="cal-count is-missed">1</span> <%= t("dash.legend_missed") %></span>
    <span><span class="cal-count is-booked">3</span> <%= t("dash.legend_booked") %></span>
  </div>

  <div class="cal-day-panel">
    <div class="panel-head" style="margin-bottom:8px">
      <div class="panel-title" style="font-size:14px">
        <%= selectedLabel %><% if (selected === todayISO) { %> <span class="badge ok"><%= t("dash.today") %></span><% } %>
      </div>
      <% if (dayAppts.length) { %>
        <a class="mini-btn" href="/appointments?date=<%= selected %>"><%= t("dash.open_list") %></a>
      <% } else { %>
        <a class="mini-btn" href="/appointments/new"><%= t("dash.book") %></a>
      <% } %>
    </div>

    <% if (!dayAppts.length) { %>
      <p class="muted" style="margin:4px 2px;font-size:13px"><%= t("dash.no_appts_day") %></p>
    <% } else { %>
      <div class="status-list">
        <% dayAppts.forEach(function (a) { %>
          <%
            const badge = { scheduled: ["info", t("status.scheduled")], completed: ["ok", t("status.completed")],
                            missed: ["bad", t("status.missed")], cancelled: ["warn", t("status.cancelled")] }[a.status]
                          || ["info", a.status];
          %>
          <div class="status-row">
            <div class="status-label">
              <b><%= a.appointment_time ? a.appointment_time.slice(0, 5) : "—" %></b>
              &nbsp;<a href="/patients/<%= a.patient_id %>"><%= a.full_name %></a>
              <small>
                <%= a.service_name.replace(/_/g, " ") %><%= a.notes ? " · " + a.notes : "" %>
              </small>
            </div>
            <span class="badge <%= badge[0] %>"><%= badge[1] %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
<% } %>

<section class="card">
  <div class="panel-head"><div class="panel-title"><%= t("dash.quick") %></div></div>
  <ol class="steps">
    <li><%- t("dash.q1", { a: `<a href="/patients/new">${t("dash.q1a")}</a>`, b: `<a href="/appointments/new">${t("dash.q1b")}</a>` }) %></li>
    <li><%- t("dash.q2", { a: `<a href="/appointments?date=${todayISO}">${t("dash.q2a")}</a>` }) %></li>
    <li><%- t("dash.q3", { a: `<a href="/forms">${t("dash.q3a")}</a>` }) %></li>
  </ol>
</section>
