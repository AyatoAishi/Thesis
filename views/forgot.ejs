<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="auth-body">
  <main class="auth-wrap">
    <div class="auth-card">
      <div class="auth-brand">
        <span class="brand-badge"><%- include("partials/logo", { logoSize: 30 }) %></span>
        <div>
          <b>Sampaguita Health Clinic</b>
          <span class="muted">Staff</span>
        </div>
      </div>

      <a class="auth-back" href="/login">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
             stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
        <span>Back to sign in</span>
      </a>

      <h1 class="auth-title">Forgot your password?</h1>

      <% if (done) { %>
        <div class="auth-notice"><%= done %></div>
        <p class="muted" style="font-size:13px;margin:12px 0 0">
          Once they approve it, sign in with the temporary password and request a
          new one of your own from <b>My account</b>.
        </p>
      <% } else { %>
        <p class="muted" style="font-size:13px;margin:0 0 14px;line-height:1.55">
          Staff passwords are reset by the admin. Enter your username and they will
          see your request. Forgot your username too? Ask the admin — it is listed
          under Staff accounts.
        </p>
        <% if (error) { %><div class="auth-error"><%= error %></div><% } %>
        <form method="POST" action="/forgot" class="auth-form"><%- include("partials/csrf") %>
          <label class="field">
            <span>Username</span>
            <input type="text" name="username" value="<%= username %>" autocomplete="username"
                   required autofocus autocapitalize="none" spellcheck="false" />
          </label>
          <button type="submit" class="btn auth-submit">Send request to the admin</button>
        </form>
      <% } %>
    </div>
  </main>
</body>
</html>
