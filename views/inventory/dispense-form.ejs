<%
  // "Can add more medicines para d paisa isa" — Alyanna. Somebody leaving with
  // three medicines used to mean filling this form three times, picking the
  // same patient each time.
  //
  // Each row's medicine is the same type-to-search picker as the patient box
  // (panel review, Oct 2026: scrolling a dropdown for the right medicine was
  // slow, and it only gets slower as the inventory grows). A row added with
  // "+ Add medicine" is a copy of the first, and the script at the bottom
  // wires the copy's picker up — cloning copies markup, not listeners.
  //
  // `lines` is what the server sends back after a validation failure, so a
  // rejected form reopens with all the rows still filled in. First load gets
  // one empty row, or one row pre-filled when arriving from a medicine's page.
  const rows = (typeof lines !== "undefined" && lines && lines.length)
    ? lines
    : [{ medicine_id: medicine ? medicine.medicine_id : (dispense.medicine_id || ""), quantity: dispense.quantity || "", instructions: "" }];
  const medItems = (medicines || []).map(m => ({
    id: m.medicine_id,
    label: m.name + (m.dosage ? " " + m.dosage : ""),
    meta: `${m.unit || "unit"} · ${m.stock_quantity > 0 ? m.stock_quantity + " in stock" : "out of stock"}`,
  }));
%>
<%- include("../partials/back", { href: "/inventory", to: "Back to inventory" }) %>
<div class="page-head">
  <h1>Dispense medicine</h1>
</div>

<% if (errors && errors.length) { %>
  <div class="card" style="border-color:var(--bad);background:var(--bad-bg)">
    <b style="color:var(--bad-ink)">Please fix:</b>
    <ul style="margin:8px 0 0;color:var(--bad-ink);font-size:13px">
      <% errors.forEach(e => { %><li><%= e %></li><% }) %>
    </ul>
  </div>
<% } %>

<form method="POST" action="/inventory/dispense"><%- include("../partials/csrf") %>
  <%# overflow:visible — the patient picker's result list drops below the card's
      own height, and .card sets overflow-x which silently clips it. %>
  <div class="card" style="overflow:visible">
    <div class="form-grid">
      <label class="field" style="grid-column:1/-1"><span>Patient *</span>
        <% if (patient) { %>
          <input type="hidden" name="patient_id" value="<%= patient.patient_id %>" />
          <input type="text" value="<%= patient.full_name %> — <%= patient.patient_number %>" disabled />
        <% } else if (!patients.length) { %>
          <p class="muted" style="margin:6px 0 0">No patients registered yet. <a href="/patients/new">Add one first →</a></p>
        <% } else { %>
          <%- include("../partials/patient-picker", { patients, selectedId: dispense.patient_id }) %>
        <% } %>
      </label>
    </div>
  </div>

  <%# overflow:visible for the same reason as the patient card above: each
      row's search results drop below the card's edge. %>
  <div class="card" style="overflow:visible">
    <div class="panel-head" style="margin-bottom:4px">
      <div>
        <div class="panel-title">Medicines</div>
        <div class="muted" style="font-size:12.5px;margin-top:3px">
          <%= t("inv.dispense_medicines_hint") %>
        </div>
      </div>
    </div>

    <% if (!medicines.length) { %>
      <p class="muted" style="margin:10px 0 0">No medicines in inventory yet. <a href="/inventory/new">Add one first →</a></p>
    <% } else { %>
      <div data-dispense-lines>
        <% rows.forEach(function (ln, i) { %>
          <div class="dispense-line" data-dispense-line>
            <label class="field"><span<%= i ? ' class="sr-only"' : "" %>>Medicine *</span>
              <%- include("../partials/search-picker", {
                    items: medItems,
                    name: "line_medicine_id",
                    selectedId: ln.medicine_id,
                    placeholder: "Type a medicine name…",
                    requiredMsg: "Choose a medicine from the list.",
                  }) %>
            </label>
            <label class="field dispense-qty"><span<%= i ? ' class="sr-only"' : "" %>>Quantity *</span>
              <input type="number" name="line_quantity" min="1" step="1"
                     value="<%= ln.quantity || "" %>" required />
            </label>
            <%# "Mag add tayo ng space don para matype ng staff/nurse kung gano
                kadalas ittake ung meds pero make it optional nalang." One per
                medicine, because two medicines from one visit are rarely taken
                the same way. It shows on the patient's own portal. %>
            <label class="field dispense-how"><span<%= i ? ' class="sr-only"' : "" %>>How often <span class="muted">(optional)</span></span>
              <input type="text" name="line_instructions" maxlength="160"
                     value="<%= ln.instructions || "" %>" placeholder="e.g. 1 tablet, 3x a day after meals" />
            </label>
            <%# Hidden on the first row: removing the only line would leave a
                form that cannot be submitted, and a button that sometimes does
                nothing is worse than one that is not there. %>
            <button type="button" class="mini-btn dispense-drop" data-drop-line
                    <%= rows.length === 1 ? "hidden" : "" %>
                    aria-label="<%= t('inv.remove_line') %>"><%= t("inv.remove_line") %></button>
          </div>
        <% }) %>
      </div>

      <button type="button" class="mini-btn" data-add-line style="margin-top:4px"><%= t("inv.add_line") %></button>
    <% } %>
  </div>

  <div class="card">
    <div class="form-grid">
      <label class="field" style="grid-column:1/-1"><span>Notes <span class="muted">(optional)</span></span>
        <input type="text" name="notes" value="<%= dispense.notes || '' %>" maxlength="255"
               placeholder="e.g. for fever — follow up in one week" />
        <span class="muted" style="font-size:11.5px;font-weight:500">
          For the whole visit. How often to take each medicine goes on its own line above.
        </span>
      </label>
    </div>
  </div>

  <button type="submit" class="btn">Dispense</button>
</form>

<script>
  // Rows are cloned from the first one and emptied, so a row added here is
  // exactly the shape the server already knows how to read — nothing to keep
  // in step by hand.
  (function () {
    var box = document.querySelector("[data-dispense-lines]");
    var add = document.querySelector("[data-add-line]");
    if (!box || !add) return;

    function refreshDropButtons() {
      var lines = box.querySelectorAll("[data-dispense-line]");
      lines.forEach(function (l) {
        var b = l.querySelector("[data-drop-line]");
        if (b) b.hidden = lines.length === 1;
      });
    }

    add.addEventListener("click", function () {
      var first = box.querySelector("[data-dispense-line]");
      if (!first) return;
      var copy = first.cloneNode(true);
      copy.querySelectorAll("select, input").forEach(function (f) { f.value = ""; });
      var res = copy.querySelector("[data-picker-results]");
      if (res) { res.innerHTML = ""; res.hidden = true; }
      // The labels only belong on the first row; repeating "Medicine" down the
      // page is noise, but they stay in the markup for screen readers.
      copy.querySelectorAll("label > span").forEach(function (s) { s.className = "sr-only"; });
      box.appendChild(copy);
      if (window.initSearchPicker) window.initSearchPicker(copy.querySelector("[data-picker]"));
      refreshDropButtons();
      var search = copy.querySelector("[data-picker-search]");
      if (search) search.focus();
    });

    box.addEventListener("click", function (e) {
      var b = e.target.closest("[data-drop-line]");
      if (!b) return;
      var lines = box.querySelectorAll("[data-dispense-line]");
      if (lines.length <= 1) return;
      b.closest("[data-dispense-line]").remove();
      refreshDropButtons();
    });

    refreshDropButtons();
  })();
</script>
