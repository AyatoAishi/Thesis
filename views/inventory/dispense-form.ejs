<div class="page-head">
  <h1>Dispense medicine</h1>
  <div class="sub"><a href="/inventory" class="back-link">← Back to inventory</a></div>
</div>

<% if (errors && errors.length) { %>
  <div class="card" style="border-color:#f3c9cb;background:var(--bad-bg)">
    <b style="color:var(--bad-ink)">Please fix:</b>
    <ul style="margin:8px 0 0;color:var(--bad-ink);font-size:13px">
      <% errors.forEach(e => { %><li><%= e %></li><% }) %>
    </ul>
  </div>
<% } %>

<form method="POST" action="/inventory/dispense">
  <%# overflow:visible — the pickers' result lists drop below the card's own
      height, and .card sets overflow-x which silently clips them. %>
  <div class="card" style="overflow:visible">
    <div class="form-grid">
      <label class="field" style="grid-column:1/-1"><span>Patient *</span>
        <% if (patient) { %>
          <input type="hidden" name="patient_id" value="<%= patient.patient_id %>" />
          <input type="text" value="<%= patient.full_name %> — <%= patient.patient_number %>" disabled />
        <% } else if (!patients.length) { %>
          <p class="muted" style="margin:6px 0 0">No patients registered yet. <a href="/patients/new">Add one first →</a></p>
        <% } else { %>
          <%- include("../partials/patient-picker", { patients, selectedId: dispense.patient_id }) %>
        <% } %>
      </label>

      <label class="field" style="grid-column:1/-1"><span>Medicine *</span>
        <% if (medicine) { %>
          <input type="hidden" name="medicine_id" value="<%= medicine.medicine_id %>" />
          <input type="text" value="<%= medicine.name %><%= medicine.dosage ? ' ' + medicine.dosage : '' %> (<%= medicine.unit || 'unit' %>) — <%= medicine.stock_quantity %> in stock" disabled />
        <% } else if (!medicines.length) { %>
          <p class="muted" style="margin:6px 0 0">No medicines in inventory yet. <a href="/inventory/new">Add one first →</a></p>
        <% } else { %>
          <%- include("../partials/search-picker", {
                items: medicines.map(med => ({
                  id: med.medicine_id,
                  label: `${med.name}${med.dosage ? " " + med.dosage : ""} (${med.unit || "unit"})`,
                  meta: `${med.stock_quantity} in stock`,
                })),
                name: "medicine_id",
                selectedId: dispense.medicine_id,
                placeholder: "Search the medicine by name…",
              }) %>
        <% } %>
      </label>

      <label class="field"><span>Quantity *</span>
        <input type="number" name="quantity" min="1" step="1" value="<%= dispense.quantity || '' %>" required />
      </label>

      <label class="field" style="grid-column:1/-1"><span>Notes <span class="muted">(optional)</span></span>
        <input type="text" name="notes" value="<%= dispense.notes || '' %>" maxlength="255" placeholder="e.g. for fever, prescribed by Dr. X" />
      </label>
    </div>
  </div>

  <button type="submit" class="btn">Dispense</button>
</form>
