<%
  const isEdit = mode === "edit";
  const m = medicine || {};
  const action = isEdit ? `/inventory/${m.medicine_id}` : "/inventory";
  // Category -> subcategory (panel, Oct 2026), read back from the stored
  // columns on edit, or from what was posted after a validation error.
  const _choice = m.category ? { category: m.category, form: m.form || "" } : medUnits.toChoice(m);
  const _json = (x) => JSON.stringify(x).replace(/</g, "\\u003c");
%>
<%- include("../partials/back", { href: "/inventory", to: "Back to inventory" }) %>
<div class="page-head">
  <h1><%= isEdit ? "Edit medicine" : "Add medicine" %></h1>
</div>

<% if (errors && errors.length) { %>
  <div class="card" style="border-color:#f3c9cb;background:var(--bad-bg)">
    <b style="color:var(--bad-ink)">Please fix:</b>
    <ul style="margin:8px 0 0;color:var(--bad-ink);font-size:13px">
      <% errors.forEach(e => { %><li><%= e %></li><% }) %>
    </ul>
  </div>
<% } %>

<form method="POST" action="<%= action %>"><%- include("../partials/csrf") %>
  <%# When this form was loaded, so the server can refuse to save on top of a
      change someone else made while it sat open — see routes/inventory.js. %>
  <% if (isEdit && m.updated_at) { %>
    <input type="hidden" name="seen_at" value="<%= new Date(m.updated_at).toISOString() %>" />
  <% } %>
  <div class="card">
    <div class="panel-title" style="margin-bottom:14px">Medicine details</div>
    <div class="form-grid">
      <label class="field"><span>Name *</span>
        <input type="text" name="name" value="<%= m.name || '' %>" required />
      </label>
      <label class="field"><span>Dosage <span class="muted">(optional)</span></span>
        <input type="text" name="dosage" value="<%= m.dosage || '' %>" placeholder="e.g. 500mg, 2g" />
        <span class="muted" style="font-size:11.5px">
          <%= t("inv.dosage_hint") %>
        </span>
      </label>
      <%# Category -> subcategory (panel, Oct 2026: "gawing main category ang
          bottle, box, etc. then subcategory ang syrup, tablet"). Still a fixed
          list, never free text: "tabletgfg" once split one medicine into two.
          Tablets in a box/strip/pack/bottle ask how many are in one, and stock
          is counted in tablets; a bottle of syrup or a vial is counted whole. %>
      <label class="field"><span>Category * <span class="muted">(what it comes in)</span></span>
        <select name="category" required data-cat>
          <option value="">— choose —</option>
          <% Object.keys(medUnits.CATEGORIES).forEach(function (k) { %>
            <option value="<%= k %>" <%= _choice.category === k ? 'selected' : '' %>><%= medUnits.CATEGORIES[k].label %></option>
          <% }) %>
        </select>
      </label>
      <label class="field"><span>Subcategory * <span class="muted">(what it is)</span></span>
        <select name="form" required data-form data-current="<%= _choice.form %>">
          <option value="">— choose a category first —</option>
        </select>
      </label>
      <div class="field" style="grid-column:1/-1" data-pack hidden><span>How many in one?</span>
        <div class="pack-row">
          <span>1</span> <b data-pack-cat-word>box</b> <span>=</span>
          <input type="number" name="pieces_per_package" min="2" max="10000" step="1" data-pack-per
                 value="<%= m.pieces_per_package || '' %>" placeholder="e.g. 100" aria-label="How many in one" />
          <span data-pack-unit-word>tablets</span>
        </div>
        <span class="muted" style="font-size:11.5px">Deliveries can then be typed by the box; patients are still given any number of tablets.</span>
      </div>
      <span class="muted" style="grid-column:1/-1;font-size:12px;margin-top:-6px" data-count-note></span>
      <script type="application/json" data-cat-data><%- _json({ cats: medUnits.CATEGORIES, countable: medUnits.COUNTABLE, labels: Object.fromEntries([].concat(...Object.values(medUnits.CATEGORIES).map(c => c.forms)).map(f => [f, medUnits.formLabel(f)])) }) %></script>
      <label class="field" style="grid-column:1/-1"><span>Description</span>
        <input type="text" name="description" value="<%= m.description || '' %>" />
      </label>
      <%# Stock is typed here once, when the medicine is first added — and it
          arrives as the medicine's first batch, with its own expiry. After
          that it only moves through the medicine's page: Restock for a
          delivery, Correct count after a physical count, Dispose for expired
          or damaged boxes. Each of those writes a line in the stock ledger;
          a number typed over the total here would not. %>
      <% if (!isEdit) { %>
        <label class="field" data-open-packages hidden><span><span data-open-pack-word>Boxes</span> on hand</span>
          <input type="number" max="1000000" name="stock_packages" min="0" step="1" value="<%= m.stock_packages || 0 %>" />
        </label>
        <label class="field"><span data-open-label>Opening stock *</span>
          <input type="number" max="1000000" name="stock_quantity" min="0" step="1" value="<%= m.stock_quantity ?? 0 %>" required />
          <span class="muted" style="font-size:11.5px" data-open-total></span>
        </label>
        <label class="field"><span>Expiry date <span class="muted">(of this stock)</span></span>
          <input type="date" name="expiry_date" value="<%= m.expiry_date || '' %>" />
          <span class="muted" style="font-size:12.5px">From the box. Later deliveries get their own date.</span>
        </label>
      <% } else { %>
        <div class="field"><span>Stock</span>
          <div style="font-size:15px;padding:8px 0"><b><%= m.stock_quantity %></b> <%= m.unit || "" %> usable<% const _pk = medUnits.inPackages(m.stock_quantity, m); if (_pk) { %> <span class="muted">(<%= _pk %>)</span><% } %></div>
          <span class="muted" style="font-size:12.5px">Changed from the medicine's page — Restock, Correct count, or Dispose — so every change is recorded.</span>
        </div>
      <% } %>
      <label class="field"><span>Low-stock threshold *</span>
        <input type="number" max="1000000" name="low_stock_threshold" min="0" step="1" value="<%= m.low_stock_threshold ?? 10 %>" required />
        <span class="muted" style="font-size:11.5px">Flagged “Low” on the list once stock drops below this.</span>
      </label>
      <label class="field" style="grid-column:1/-1"><span>Source</span>
        <input type="text" name="source" value="<%= m.source || '' %>" placeholder="e.g. DOH, hospital donation" />
      </label>
    </div>
  </div>

  <div class="card">
    <label class="check">
      <input type="checkbox" name="is_family_planning" <%= m.is_family_planning ? 'checked' : '' %> />
      <span>This is a <b>family planning commodity</b> (pills, condoms, injectables, IUD, implant, etc.)</span>
    </label>
    <p class="muted" style="font-size:12px;margin:10px 0 0">
      Included in the Family Planning Acceptors report when dispensed.
    </p>
  </div>

  <button type="submit" class="btn"><%= isEdit ? "Save changes" : "Create medicine" %></button>
</form>

<script>
  // Category -> subcategory, the "1 box = N tablets" row, and on a new
  // medicine the opening stock (boxes plus loose tablets, total underneath).
  // Mirrors lib/medicineUnits.js fromChoice(); the server decides.
  (function () {
    var catSel = document.querySelector("[data-cat]");
    var formSel = document.querySelector("[data-form]");
    var dataEl = document.querySelector("[data-cat-data]");
    if (!catSel || !formSel || !dataEl) return;
    var data = JSON.parse(dataEl.textContent);
    var pack = document.querySelector("[data-pack]");
    var per = document.querySelector("[data-pack-per]");
    var catWord = document.querySelector("[data-pack-cat-word]");
    var unitWord = document.querySelector("[data-pack-unit-word]");
    var note = document.querySelector("[data-count-note]");
    var openPk = document.querySelector("[data-open-packages]");
    var openPkWord = document.querySelector("[data-open-pack-word]");
    var openLabel = document.querySelector("[data-open-label]");
    var openTotal = document.querySelector("[data-open-total]");
    var pkInput = openPk ? openPk.querySelector("input") : null;
    var looseInput = document.querySelector('input[name="stock_quantity"]');
    function plural(w, n) {
      w = w || "piece";
      if (n === 1) return w;
      if (/[^aeiou]y$/.test(w)) return w.slice(0, -1) + "ies";
      if (/(x|s|ch|sh)$/.test(w)) return w + "es";
      return w + "s";
    }
    function fillForms() {
      var cat = data.cats[catSel.value];
      var keep = formSel.value || formSel.getAttribute("data-current") || "";
      formSel.innerHTML = "";
      var first = document.createElement("option");
      first.value = ""; first.textContent = cat ? "— choose —" : "— choose a category first —";
      formSel.appendChild(first);
      (cat ? cat.forms : []).forEach(function (f) {
        var o = document.createElement("option");
        o.value = f; o.textContent = data.labels[f] || f;
        if (f === keep) o.selected = true;
        formSel.appendChild(o);
      });
      formSel.disabled = !cat;
      formSel.setAttribute("data-current", "");
    }
    function sync() {
      var cat = catSel.value, form = formSel.value;
      var packed = !!(cat && form && cat !== "piece" && data.countable.indexOf(form) !== -1);
      var counted = !form ? "" : packed || data.countable.indexOf(form) !== -1 ? form : form === "device" ? "piece" : cat;
      pack.hidden = !packed;
      per.disabled = !packed; per.required = packed;
      catWord.textContent = cat === "strip" ? "strip" : cat;
      unitWord.textContent = plural(form, 2);
      note.textContent = counted ? "Stock is counted in " + plural(counted, 2) + "." : "";
      if (!openPk) return;
      var n = parseInt(per.value, 10);
      var boxes = packed && n >= 2;
      openPk.hidden = !boxes;
      if (pkInput) pkInput.disabled = !boxes;
      openPkWord.textContent = boxes ? plural(cat, 2).replace(/^./, function (c) { return c.toUpperCase(); }) : "";
      openLabel.textContent = boxes ? "Loose " + plural(form, 2) + " on hand" : (counted ? plural(counted, 2).replace(/^./, function (c) { return c.toUpperCase(); }) + " on hand *" : "Opening stock *");
      var total = (parseInt(looseInput.value, 10) || 0) + (boxes ? (parseInt(pkInput.value, 10) || 0) * n : 0);
      openTotal.textContent = boxes ? "= " + total + " " + plural(form, total) + " in stock" : "";
    }
    catSel.addEventListener("change", function () { fillForms(); sync(); });
    [formSel, per, pkInput, looseInput].forEach(function (el) {
      if (el) { el.addEventListener("change", sync); el.addEventListener("input", sync); }
    });
    fillForms();
    sync();
  })();
</script>
