<%
  const isEdit = mode === "edit";
  const m = medicine || {};
  const action = isEdit ? `/inventory/${m.medicine_id}` : "/inventory";
%>
<div class="page-head">
  <h1><%= isEdit ? "Edit medicine" : "Add medicine" %></h1>
  <div class="sub"><a href="/inventory" class="back-link">← Back to inventory</a></div>
</div>

<% if (errors && errors.length) { %>
  <div class="card" style="border-color:#f3c9cb;background:var(--bad-bg)">
    <b style="color:var(--bad-ink)">Please fix:</b>
    <ul style="margin:8px 0 0;color:var(--bad-ink);font-size:13px">
      <% errors.forEach(e => { %><li><%= e %></li><% }) %>
    </ul>
  </div>
<% } %>

<form method="POST" action="<%= action %>"><%- include("../partials/csrf") %>
  <%# When this form was loaded, so the server can refuse to save on top of a
      change someone else made while it sat open — see routes/inventory.js. %>
  <% if (isEdit && m.updated_at) { %>
    <input type="hidden" name="seen_at" value="<%= new Date(m.updated_at).toISOString() %>" />
  <% } %>
  <div class="card">
    <div class="panel-title" style="margin-bottom:14px">Medicine details</div>
    <div class="form-grid">
      <label class="field"><span>Name *</span>
        <input type="text" name="name" value="<%= m.name || '' %>" required />
      </label>
      <label class="field"><span>Dosage <span class="muted">(optional)</span></span>
        <input type="text" name="dosage" value="<%= m.dosage || '' %>" placeholder="e.g. 500mg, 2g" />
        <span class="muted" style="font-size:11.5px">
          Ang lakas ay <b>dito lang</b>, hindi sa pangalan. "Amlodipine" + "10mg",
          hindi "Amlodipine 10mg" — kapag nasa dalawang lugar ang isang bagay,
          nagkakadoble ang gamot. Isama ang unit: <b>10mg</b>, hindi <b>10</b>.
        </span>
      </label>
      <%# A fixed list, not a text box. Two of eleven medicines in the live
          inventory were stocked in "tabletgfg" — a typo in a unit is not
          cosmetic, it splits one medicine into two lines that never add up
          again. Anything already saved off-list still appears, marked, so it
          can be corrected on purpose instead of by accident. %>
      <label class="field"><span>Unit *</span>
        <select name="unit" required>
          <option value="">— pumili —</option>
          <% unitOptions.forEach(function (u) { %>
            <option value="<%= u.value %>" <%= (m.unit || '') === u.value ? 'selected' : '' %>><%= u.label %></option>
          <% }) %>
        </select>
      </label>
      <label class="field" style="grid-column:1/-1"><span>Description</span>
        <input type="text" name="description" value="<%= m.description || '' %>" />
      </label>
      <%# Stock is typed here once, when the medicine is first added — and it
          arrives as the medicine's first batch, with its own expiry. After
          that it only moves through the medicine's page: Restock for a
          delivery, Correct count after a physical count, Dispose for expired
          or damaged boxes. Each of those writes a line in the stock ledger;
          a number typed over the total here would not. %>
      <% if (!isEdit) { %>
        <label class="field"><span>Opening stock *</span>
          <input type="number" name="stock_quantity" min="0" step="1" value="<%= m.stock_quantity ?? 0 %>" required />
        </label>
        <label class="field"><span>Expiry date <span class="muted">(of this stock)</span></span>
          <input type="date" name="expiry_date" value="<%= m.expiry_date || '' %>" />
          <span class="muted" style="font-size:12.5px">From the box. Later deliveries get their own date.</span>
        </label>
      <% } else { %>
        <div class="field"><span>Stock</span>
          <div style="font-size:15px;padding:8px 0"><b><%= m.stock_quantity %></b> <%= m.unit || "" %> usable</div>
          <span class="muted" style="font-size:12.5px">Changed from the medicine's page — Restock, Correct count, or Dispose — so every change is recorded.</span>
        </div>
      <% } %>
      <label class="field"><span>Low-stock threshold *</span>
        <input type="number" name="low_stock_threshold" min="0" step="1" value="<%= m.low_stock_threshold ?? 10 %>" required />
        <span class="muted" style="font-size:11.5px">Flagged “Low” on the list once stock drops below this.</span>
      </label>
      <label class="field" style="grid-column:1/-1"><span>Source</span>
        <input type="text" name="source" value="<%= m.source || '' %>" placeholder="e.g. DOH, hospital donation" />
      </label>
    </div>
  </div>

  <div class="card">
    <label class="check">
      <input type="checkbox" name="is_family_planning" <%= m.is_family_planning ? 'checked' : '' %> />
      <span>This is a <b>family planning commodity</b> (pills, condoms, injectables, IUD, implant, etc.)</span>
    </label>
    <p class="muted" style="font-size:12px;margin:10px 0 0">
      Included in the Family Planning Acceptors report when dispensed.
    </p>
  </div>

  <button type="submit" class="btn"><%= isEdit ? "Save changes" : "Create medicine" %></button>
</form>
