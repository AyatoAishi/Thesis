<div class="page-head" style="display:flex;align-items:center;justify-content:space-between">
  <div>
    <h1>Inventory</h1>
    <div class="sub"><%= medicines.length %> shown<%= q ? ` matching “${q}”` : "" %><%= lowOnly ? " · low stock only" : "" %></div>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <%# "Printable or exportable copy of inventory." %>
    <a class="mini-btn" href="/reports/inventory">Report &amp; export</a>
    <a class="btn" href="/inventory/new">+ Add medicine</a>
  </div>
</div>

<% if (flash) { %>
  <div class="card" style="background:var(--accent-softer);border-color:var(--accent-soft)"><%= flash %></div>
<% } %>

<div class="card">
  <div class="sum" style="margin-bottom:14px">
    <span class="sum-pill"><b><%= total %></b> medicine<%= total === 1 ? "" : "s" %></span>
    <a href="/inventory?low=1" style="text-decoration:none">
      <span class="sum-pill <%= lowCount ? 'bad' : '' %>"><b><%= lowCount %></b> low stock</span>
    </a>
    <a href="/inventory?expired=1" style="text-decoration:none">
      <span class="sum-pill <%= medicines.some(m => m.expired_waiting) || expiredOnly ? 'bad' : '' %>">expired to dispose of</span>
    </a>
    <%# Only shown once something is actually in there. A permanent "0 archived"
        pill is a control that does nothing 99% of the time and teaches the eye
        to skip that row. %>
    <% if (archivedCount) { %>
      <a href="/inventory?archived=1" style="text-decoration:none">
        <span class="sum-pill"><b><%= archivedCount %></b> archived</span>
      </a>
    <% } %>
    <% if (lowOnly || archivedOnly || expiredOnly) { %><a class="mini-btn" href="/inventory">Clear filter</a><% } %>
  </div>

  <% if (archivedOnly) { %>
    <div class="card" style="border-color:var(--warn);background:var(--warn-bg);margin-bottom:14px">
      <b style="color:var(--warn-ink)">Mga naka-archive na gamot</b>
      <p style="margin:6px 0 0;font-size:13px;color:var(--ink-2)">
        Wala sila sa inventory at wala sa dispense. Buksan ang isa at pindutin
        ang <b>Ibalik sa listahan</b> kung mali ang pag-archive.
      </p>
    </div>
  <% } %>

  <form method="GET" action="/inventory" style="margin-bottom:14px">
    <% if (lowOnly) { %><input type="hidden" name="low" value="1" /><% } %>
    <% if (archivedOnly) { %><input type="hidden" name="archived" value="1" /><% } %>
    <input class="search" type="search" name="q" value="<%= q %>"
           placeholder="Search medicine name…" style="max-width:100%" />
  </form>

  <% if (!medicines.length) { %>
    <p class="muted" style="padding:8px 2px">
      <% if (q || lowOnly || expiredOnly) { %>No medicines match this filter.<% } else { %>No medicines yet. Click <b>Add medicine</b> to create the first one.<% } %>
    </p>
  <% } else { %>
    <table class="tbl">
      <thead>
        <tr><th>Name</th><th>Unit</th><th>Usable stock</th><th>Next expiry</th><th>Source</th><th></th></tr>
      </thead>
      <tbody>
        <% medicines.forEach(m => { %>
          <% const low = m.stock_quantity < m.low_stock_threshold; %>
          <tr>
            <td>
              <a href="/inventory/<%= m.medicine_id %>"><%= m.name %></a><% if (m.dosage) { %> <span class="muted"><%= m.dosage %></span><% } %>
              <% if (m.is_family_planning) { %> <span class="badge info">FP</span><% } %>
              <% if (m.description) { %><div class="muted" style="font-size:11.5px"><%= m.description %></div><% } %>
            </td>
            <td><%= m.unit || "—" %></td>
            <td>
              <span style="<%= low ? 'color:var(--bad-ink);font-weight:700' : '' %>"><%= m.stock_quantity %></span>
              <span class="muted" style="font-size:11px"> / <%= m.low_stock_threshold %> min</span>
              <% if (low) { %><span class="badge bad" style="margin-left:6px">Low</span><% } %>
              <% if (m.expired_waiting) { %><span class="badge bad" style="margin-left:6px" title="Expired units still on the shelf"><%= m.expired_waiting %> expired</span><% } %>
            </td>
            <%
              const ne = m.next_expiry ? (m.next_expiry instanceof Date ? m.next_expiry.toLocaleDateString("en-CA", { timeZone: "Asia/Manila" }) : String(m.next_expiry).slice(0, 10)) : null;
              const soon = ne && (() => { const t = new Date(today + "T00:00:00Z"); t.setUTCDate(t.getUTCDate() + 30); return ne <= t.toISOString().slice(0, 10); })();
            %>
            <td style="white-space:nowrap;<%= soon ? 'color:var(--warn-ink);font-weight:700' : '' %>">
              <%= ne ? new Date(ne + "T00:00:00+08:00").toLocaleDateString("en-PH", { timeZone: "Asia/Manila", year: "numeric", month: "short", day: "numeric" }) : (m.stock_quantity ? "not recorded" : "—") %>
            </td>
            <td><%= m.source || "—" %></td>
            <td style="text-align:right"><a href="/inventory/<%= m.medicine_id %>/edit" class="muted">Edit</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
