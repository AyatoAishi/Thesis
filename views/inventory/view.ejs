<%
  const m = medicine;
  const low = m.stock_quantity < m.low_stock_threshold;
  function fmt(ts) {
    if (!ts) return "—";
    return new Date(ts).toLocaleString("en-PH", { timeZone: "Asia/Manila", year: "numeric", month: "short", day: "numeric", hour: "numeric", minute: "2-digit" });
  }
%>
<div class="page-head" style="display:flex;align-items:center;justify-content:space-between">
  <div>
    <h1><%= m.name %><% if (m.dosage) { %> <span class="muted" style="font-weight:400"><%= m.dosage %></span><% } %>
      <% if (m.is_family_planning) { %><span class="badge info" style="vertical-align:middle">Family planning</span><% } %>
      <% if (low) { %><span class="badge bad" style="vertical-align:middle">Low stock</span><% } %>
    </h1>
    <div class="sub"><%= m.description || " " %></div>
  </div>
  <div style="display:flex;gap:8px">
    <% if (!m.archived_at) { %>
      <a class="btn" href="/inventory/dispense/new?medicine_id=<%= m.medicine_id %>">+ Dispense</a>
    <% } %>
    <a class="mini-btn" href="/inventory/<%= m.medicine_id %>/edit">Edit</a>
    <%# Archive, never delete. medicine_dispenses points at this row to say what
        a patient was given, so deleting it either fails on the foreign key or
        destroys that record. There is no confirm dialog because there is
        nothing to lose — Restore is one press, and it is right there. %>
    <form method="POST" action="/inventory/<%= m.medicine_id %>/archive" style="margin:0">
      <%- include("../partials/csrf") %>
      <% if (m.archived_at) { %>
        <input type="hidden" name="restore" value="yes" />
        <button type="submit" class="btn">Ibalik sa listahan</button>
      <% } else { %>
        <button type="submit" class="mini-btn">Archive</button>
      <% } %>
    </form>
    <a class="logout-btn" href="/inventory" style="display:inline-flex;align-items:center;text-decoration:none">Back</a>
  </div>
</div>

<% if (m.archived_at) { %>
  <div class="card" style="border-color:var(--warn);background:var(--warn-bg)">
    <b style="color:var(--warn-ink)">Naka-archive ang gamot na ito</b>
    <p style="margin:6px 0 0;font-size:13px;color:var(--ink-2);line-height:1.55">
      Wala siya sa listahan ng inventory at wala sa dropdown ng dispense. Buo pa
      rin ang lahat ng naunang dispense niya — walang naburang record.
      <% if (m.stock_quantity > 0) { %>
        <br /><b>May <%= m.stock_quantity %> pa siyang stock.</b> Kung may
        natitira talaga sa lalagyan, ibalik siya sa listahan; kung wala, i-edit
        at gawing 0 ang stock — kung hindi, may binibilang na gamot na walang
        makakagamit.
      <% } %>
    </p>
  </div>
<% } %>

<% if (flash) { %>
  <div class="card" style="background:var(--accent-softer);border-color:var(--accent-soft)"><%= flash %></div>
<% } %>

<% if (typeof err !== "undefined" && err) { %>
  <div class="page-alert bad"><%= err %></div>
<% } %>
<%
  const soon = (() => { const t = new Date(today + "T00:00:00Z"); t.setUTCDate(t.getUTCDate() + soonDays); return t.toISOString().slice(0, 10); })();
  const dStr = (d) => d ? (d instanceof Date ? d.toLocaleDateString("en-CA", { timeZone: "Asia/Manila" }) : String(d).slice(0, 10)) : null;
  const fmtD = (d) => d ? new Date(d + "T00:00:00+08:00").toLocaleDateString("en-PH", { timeZone: "Asia/Manila", year: "numeric", month: "short", day: "numeric" }) : "—";
  const awaiting = batches.filter(b => !b.disposed_at && b.expired_quantity > 0).reduce((n, b) => n + b.expired_quantity, 0);
  const expiringSoon = batches.filter(b => !b.disposed_at && b.quantity_remaining > 0 && dStr(b.expiry_date) && dStr(b.expiry_date) <= soon).reduce((n, b) => n + b.quantity_remaining, 0);
%>

<div class="card">
  <div class="panel-title" style="margin-bottom:12px">Stock</div>
  <dl class="kv">
    <div><dt>Usable stock</dt><dd style="font-weight:700<%= low ? ';color:var(--bad-ink)' : '' %>"><%= m.stock_quantity %> <%= m.unit || "" %></dd></div>
    <div><dt>Low-stock threshold</dt><dd><%= m.low_stock_threshold %></dd></div>
    <div><dt>Expiring within <%= soonDays %> days</dt><dd style="<%= expiringSoon ? 'color:var(--warn-ink);font-weight:700' : '' %>"><%= expiringSoon %> <%= m.unit || "" %></dd></div>
    <div><dt>Expired, waiting to be disposed of</dt><dd style="<%= awaiting ? 'color:var(--bad-ink);font-weight:700' : '' %>"><%= awaiting %> <%= m.unit || "" %></dd></div>
  </dl>
</div>

<%# "When will the expired medicines be removed?" — the day after the date on
    the box, automatically: a batch past its expiry leaves usable stock and
    can no longer be dispensed. What remains is the physical box on the
    shelf, listed here until somebody presses Dispose to record that it is
    gone. %>
<div class="card">
  <div class="svc-head" style="flex-wrap:wrap;gap:8px">
    <span class="panel-title">Batches</span>
    <span class="muted" style="font-size:13px">Dispensing always takes from the batch that expires first.</span>
  </div>
  <% if (!batches.length) { %>
    <p class="muted" style="margin:6px 2px 0">No stock has been received for this medicine yet.</p>
  <% } else { %>
    <div style="overflow-x:auto;padding-bottom:4px">
      <table class="tbl">
        <thead><tr><th>Received</th><th>Expiry</th><th>Usable</th><th>Status</th><th>Source / note</th><th></th></tr></thead>
        <tbody>
          <% batches.forEach(b => { %>
            <%
              const exp = dStr(b.expiry_date);
              let st = ["ok", "In use"];
              if (b.disposed_at) st = ["info", "Disposed"];
              else if (b.expired_quantity > 0) st = ["bad", b.expired_quantity + " expired — dispose"];
              else if (!b.quantity_remaining) st = ["info", "Used up"];
              else if (!exp) st = ["warn", "Expiry not recorded"];
              else if (exp <= soon) st = ["warn", "Expires soon"];
            %>
            <tr>
              <td style="white-space:nowrap"><%= fmtD(dStr(b.received_at)) %></td>
              <td style="white-space:nowrap"><%= exp ? fmtD(exp) : "—" %></td>
              <td><b><%= b.quantity_remaining %></b> <span class="muted">/ <%= b.quantity_received %></span></td>
              <td><span class="badge <%= st[0] %>"><%= st[1] %></span></td>
              <td class="muted" style="font-size:13px"><%= b.source || (b.note ? b.note.slice(0, 48) : "—") %></td>
              <td style="text-align:right">
                <% if (!b.disposed_at) { %>
                  <details class="batch-actions">
                    <summary class="mini-btn">Manage</summary>
                    <div class="batch-menu">
                      <% if (!exp) { %>
                        <form method="POST" action="/inventory/batches/<%= b.batch_id %>/expiry"><%- include("../partials/csrf") %>
                          <label class="field"><span>Expiry on the box</span><input type="date" name="expiry_date" required /></label>
                          <button type="submit" class="mini-btn">Save expiry</button>
                        </form>
                      <% } %>
                      <% if (b.quantity_remaining > 0 || !b.expired_quantity) { %>
                        <form method="POST" action="/inventory/batches/<%= b.batch_id %>/correct"><%- include("../partials/csrf") %>
                          <label class="field"><span>Counted on the shelf</span><input type="number" name="counted" min="0" step="1" value="<%= b.quantity_remaining %>" required /></label>
                          <label class="field"><span>Why it changed</span><input type="text" name="reason" maxlength="120" placeholder="e.g. physical count, broken bottle" required /></label>
                          <button type="submit" class="mini-btn">Correct count</button>
                        </form>
                      <% } %>
                      <%
                        const parts = [];
                        if (b.expired_quantity) parts.push(b.expired_quantity + " expired");
                        if (b.quantity_remaining) parts.push(b.quantity_remaining + " still-usable");
                      %>
                      <form method="POST" action="/inventory/batches/<%= b.batch_id %>/dispose"
                            data-confirm-title="Dispose of this batch?"
                            data-confirm="<%= parts.join(" and ") %> unit(s) are recorded as leaving the shelf. | This cannot be undone."
                            data-confirm-yes="Yes, record disposal" data-confirm-no="Cancel"><%- include("../partials/csrf") %>
                        <label class="field"><span>Note <span class="muted">(optional)</span></span><input type="text" name="note" maxlength="120" placeholder="e.g. returned to the city health office" /></label>
                        <button type="submit" class="logout-btn">Dispose</button>
                      </form>
                    </div>
                  </details>
                <% } else { %>
                  <span class="muted" style="font-size:12.5px"><%= b.disposed_by_name ? "by " + b.disposed_by_name : "" %></span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <% if (!m.archived_at) { %>
    <details class="restock-box" <%= batches.length ? "" : "open" %>>
      <summary>+ Restock (new delivery)</summary>
      <form method="POST" action="/inventory/<%= m.medicine_id %>/restock" class="form-grid" style="margin-top:12px"><%- include("../partials/csrf") %>
        <label class="field"><span>Quantity received *</span><input type="number" name="quantity" min="1" step="1" required /></label>
        <label class="field"><span>Expiry date *</span><input type="date" name="expiry_date" required min="<%= today %>" /></label>
        <label class="field"><span>Source</span><input type="text" name="source" maxlength="150" placeholder="e.g. City Health Office" /></label>
        <label class="field"><span>Note</span><input type="text" name="note" maxlength="200" placeholder="optional" /></label>
        <button type="submit" class="btn" style="align-self:flex-end">Add batch</button>
      </form>
    </details>
  <% } %>
</div>


<div class="card">
  <div class="svc-head">
    <span class="panel-title">Dispense history</span>
    <span class="muted"><%= dispenses.length %> record<%= dispenses.length === 1 ? "" : "s" %></span>
  </div>
  <% if (!dispenses.length) { %>
    <p class="muted" style="margin:6px 2px 0">No dispenses recorded yet.</p>
  <% } else { %>
    <table class="tbl">
      <thead><tr><th>When</th><th>Patient</th><th>Qty</th><th>Dispensed by</th><th>Notes</th></tr></thead>
      <tbody>
        <% dispenses.forEach(d => { %>
          <tr>
            <td class="mono" style="font-size:12px"><%= fmt(d.dispensed_at) %></td>
            <td><a href="/patients/<%= d.patient_id %>"><%= d.full_name %></a></td>
            <td><%= d.quantity %></td>
            <td><%= d.dispensed_by_name || "—" %></td>
            <td class="muted" style="font-size:12.5px"><%= d.notes || "—" %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%# The ledger the review asked for: every restock, dispense, expiry,
    disposal, correction, archive and restore, with what it did to usable
    stock and what stock was right after. Exportable from Reports. %>
<div class="card">
  <div class="svc-head">
    <span class="panel-title">Stock history</span>
    <a class="mini-btn" href="/reports/stock-movements?medicine_id=<%= m.medicine_id %>">Full history &amp; export</a>
  </div>
  <% if (!movements.length) { %>
    <p class="muted" style="margin:6px 2px 0">No stock movements yet.</p>
  <% } else { %>
    <% const kindLabel = { opening: ["info", "Opening"], restock: ["ok", "Restock"], dispense: ["info", "Dispensed"], expire: ["bad", "Expired"], dispose: ["warn", "Disposed"], adjust: ["warn", "Correction"], archive: ["info", "Archived"], restore: ["info", "Restored"] }; %>
    <div class="scroll-box" style="max-height:380px">
      <table class="tbl">
        <thead><tr><th>When</th><th>What</th><th>Change</th><th>Stock after</th><th>By</th><th>Note</th></tr></thead>
        <tbody>
          <% movements.forEach(mv => { %>
            <% const kl = kindLabel[mv.kind] || ["info", mv.kind]; %>
            <tr>
              <td class="mono" style="font-size:12.5px;white-space:nowrap"><%= fmt(mv.at) %></td>
              <td><span class="badge <%= kl[0] %>"><%= kl[1] %></span></td>
              <td class="mono" style="<%= mv.stock_delta < 0 ? 'color:var(--bad-ink)' : mv.stock_delta > 0 ? 'color:var(--ok-ink)' : '' %>"><%= mv.stock_delta > 0 ? "+" : "" %><%= mv.stock_delta %></td>
              <td class="mono"><%= mv.stock_after %></td>
              <td style="font-size:13px"><%= mv.by_name || "—" %></td>
              <td class="muted" style="font-size:12.5px"><%= mv.note || "" %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
