<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="auth-body">
  <main class="auth-wrap">
    <div class="auth-card">
      <div class="auth-brand">
        <span class="brand-badge">S</span>
        <div>
          <b>Sampaguita Health Clinic</b>
          <span class="muted">EMR &amp; Appointments</span>
        </div>
      </div>

      <%- include("partials/auth-toggle", { authSide: "staff" }) %>

      <h1 class="auth-title">Staff sign in</h1>

      <% if (error) { %>
        <div class="auth-error"><%= error %></div>
      <% } %>

      <%# Someone is already signed in on this browser. Say so plainly and make
          them choose — this page must never hand over the dashboard on its own. %>
      <% if (typeof signedInAs !== "undefined" && signedInAs) { %>
        <div class="auth-notice warn">
          <b><%= signedInAs %></b> is still signed in on this computer.
          <div class="auth-notice-actions">
            <a class="mini-btn" href="/dashboard">Continue as <%= signedInAs %></a>
            <form method="POST" action="/logout" style="margin:0">
              <button type="submit" class="mini-btn">Sign out</button>
            </form>
          </div>
          <span class="muted">Or sign in below as someone else.</span>
        </div>
      <% } %>

      <form method="POST" action="/login" class="auth-form">
        <label class="field">
          <span>Username</span>
          <input type="text" name="username" value="<%= username %>" autocomplete="username"
                 required autofocus autocapitalize="none" spellcheck="false" />
        </label>

        <label class="field">
          <span>Password</span>
          <%- include("partials/password-field", { name: "password", id: "pw" }) %>
        </label>

        <button type="submit" class="btn auth-submit">Sign in</button>
      </form>

      <p class="auth-foot muted">Authorized clinic staff only · RA 10173 protected</p>
    </div>
  </main>
</body>
</html>
