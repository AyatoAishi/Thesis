<%#
  Shown right after signing in while the account is still on a password
  somebody else gave it — the admin for staff, the clinic desk for patients
  (panel review, Oct 2026). Skippable, and shown again at every sign-in until
  the person sets their own. Expects: side ("staff" | "patient"), action,
  skipAction, error.
%>
<!DOCTYPE html>
<html lang="<%= lang === 'tl' ? 'fil' : 'en' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="auth-body">
  <main class="auth-wrap">
    <div class="auth-card">
      <div class="auth-brand">
        <span class="brand-badge"><%- include("partials/logo", { logoSize: 30 }) %></span>
        <div>
          <b>Sampaguita Health Clinic</b>
          <span class="muted"><%= side === "staff" ? "EMR & Appointments" : "Patient portal" %></span>
        </div>
      </div>

      <h1 class="auth-title"><%= t("npw.title") %></h1>
      <p class="muted" style="font-size:13.5px;margin:-4px 0 14px">
        <%= side === "staff" ? t("npw.why_staff") : t("npw.why_patient") %>
      </p>

      <% if (error) { %>
        <div class="auth-error"><%= error %></div>
      <% } %>

      <form method="POST" action="<%= action %>" class="auth-form"><%- include("partials/csrf") %>
        <label class="field">
          <span><%= t("npw.new") %> <span class="muted"><%= t("npw.min") %></span></span>
          <%- include("partials/password-field", { name: "new_password", minlength: 8, autocomplete: "new-password", id: "npw-1" }) %>
        </label>
        <label class="field">
          <span><%= t("npw.again") %></span>
          <%- include("partials/password-field", { name: "confirm_password", minlength: 8, autocomplete: "new-password", id: "npw-2" }) %>
        </label>
        <% if (side === "staff") { %>
          <p class="muted" style="font-size:12px;margin:0"><%= t("npw.staff_now") %></p>
        <% } %>
        <button type="submit" class="btn auth-submit"><%= t("npw.save") %></button>
      </form>

      <form method="POST" action="<%= skipAction %>" style="margin:14px 0 0;text-align:center"><%- include("partials/csrf") %>
        <button type="submit" class="mini-btn"><%= t("npw.skip") %></button>
        <p class="muted" style="font-size:12px;margin:8px 0 0"><%= t("npw.skip_note") %></p>
      </form>
    </div>
  </main>
  <%- include("partials/clinic-footer") %>
</body>
</html>
