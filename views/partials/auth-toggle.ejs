<%
  // Was a Patient | Clinic staff switch. The professors asked for the two
  // sign-in pages to stop leading into each other: "kapag naclick na yung
  // Patient, dapat hindi na nalilipat sa Clinic Staff log in … but add a back
  // button just in case they misclicked."
  //
  // So each page is now one door, and the only way sideways is back out to the
  // landing page, where the choice is made on purpose. A patient who never sees
  // a staff button cannot wander into the staff sign-in and conclude their
  // password is wrong.
  const side = typeof authSide !== "undefined" ? authSide : "patient";
%>
<a class="auth-back" href="/">
  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
       stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M15 18l-6-6 6-6" />
  </svg>
  <span>Back</span>
</a>
