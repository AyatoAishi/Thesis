<%
  // Grouping a household, in plain language: staff search relatives by name and
  // never see or type the underlying code.
  //
  // A household is not a pair. Everyone in it shares one number, so it holds as
  // many people as the family has — but the old version showed a single chip and
  // then hid the search box, which made it look like you could only ever link
  // two people. Now the whole household is listed and the search stays open so
  // another member can always be added.
  //
  // Nothing is written to the database until the form is submitted: picking a
  // name here only queues it, so backing out of the form leaves the other
  // patient untouched.
  const _list = (familyLookup || []).map(p => ({ id: p.patient_id, name: p.full_name, num: p.patient_number }));
  const _members = (typeof familyMembers !== "undefined" ? familyMembers : []) || [];
  const _famNum = typeof selectedFamilyNumber !== "undefined"
    ? (selectedFamilyNumber || "")
    : (patient && patient.family_number) || "";
  const _joinIds = (patient && patient.family_join_ids) || "";

  // JSON.stringify does not escape "<", so a patient whose name contained
  // "</script>" would close this tag early and the rest of their name would be
  // parsed as HTML. Only staff can type a patient name, but "only staff can
  // reach it" is not the same as safe.
  const _json = (x) => JSON.stringify(x).replace(/</g, "\\u003c");
%>
<div class="family-link" data-family-link>
  <input type="hidden" name="family_number" data-family-link-value value="<%= _famNum %>" />
  <input type="hidden" name="family_join_ids" data-family-join-ids value="<%= _joinIds %>" />

  <div class="family-members" data-family-members <%= _members.length ? "" : "hidden" %>>
    <div class="family-members-label muted">In this household:</div>
    <div class="family-chip-row">
      <% _members.forEach(m => { %>
        <span class="family-chip-static">
          <b><%= m.full_name %></b>
          <span class="muted mono"><%= m.patient_number %></span>
        </span>
      <% }) %>
    </div>
    <button type="button" class="mini-btn" data-family-link-clear>Remove from this household</button>
  </div>

  <%# Picked on this form but not saved yet. %>
  <div class="family-chip-row" data-family-pending hidden></div>

  <div data-family-link-search-wrap>
    <input type="text" data-family-link-search autocomplete="off"
           placeholder="Type a relative's name to add them — they must already be registered" />
    <div class="patient-picker-results" data-family-link-results hidden></div>
  </div>

  <script type="application/json" data-family-link-data><%- _json(_list) %></script>
</div>
