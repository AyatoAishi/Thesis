<%
  // Plain-language family linking: staff search a relative by name (never a
  // code) and either see a confirmation chip (already linked) or a search
  // box (not linked yet) — never both, never a raw "26-00"-style number.
  const _list = (familyLookup || []).map(p => ({ id: p.patient_id, name: p.full_name, num: p.patient_number }));
  const _members = ((typeof familyMembers !== "undefined" ? familyMembers : []) || []).map(m => m.full_name);
  const _famNum = typeof selectedFamilyNumber !== "undefined" ? (selectedFamilyNumber || "") : (patient && patient.family_number) || "";
  const _linked = !!_famNum;
  const _chipText = _members.length ? `Linked with ${_members.join(", ")}` : "Linked with a family";
%>
<div class="family-link" data-family-link>
  <input type="hidden" name="family_number" data-family-link-value value="<%= _famNum %>" />

  <div class="family-chip" data-family-link-chip <%= _linked ? "" : "hidden" %>>
    <span data-family-link-chip-text><%= _chipText %></span>
    <button type="button" class="mini-btn" data-family-link-clear>Remove</button>
  </div>

  <div data-family-link-search-wrap <%= _linked ? "hidden" : "" %>>
    <input type="text" data-family-link-search autocomplete="off"
           placeholder="Search a family member's name — only if they're already registered" />
    <div class="patient-picker-results" data-family-link-results hidden></div>
  </div>

  <script type="application/json" data-family-link-data><%- JSON.stringify(_list) %></script>
</div>
