<%
  // The clinic's mark, in one place. Included by the rail, the topbar, the
  // landing page, every sign-in page, the legal pages and the portal.
  //
  // 2026-09-25: the official Barangay Sampaguita seal, replacing the flower
  // mark we drew ourselves. The professors asked for it by name ("Add logo",
  // with the seal attached), and it is the right call: this is the barangay's
  // own health station, and its seal is what residents already recognise on
  // every paper form the clinic hands them — the prenatal record included.
  //
  // One file per size rather than one big image scaled down in the browser, so
  // a 30px badge does not download a 256px picture. srcset hands high-density
  // screens the next size up, which is what keeps the small lettering on the
  // ring legible on a phone.
  //
  // `logoSize` in px. `logoMono` is accepted and ignored — the seal has fixed
  // colours by definition, and a recoloured official seal is not the seal.
  const size = typeof logoSize !== "undefined" ? logoSize : 32;
  const one = size <= 32 ? 64 : size <= 80 ? 160 : 256;
  const two = size <= 32 ? 160 : 256;
%><img class="seal-img" src="/img/barangay-seal-<%= one %>.png"
     srcset="/img/barangay-seal-<%= one %>.png 1x, /img/barangay-seal-<%= two %>.png 2x"
     width="<%= size %>" height="<%= size %>"
     alt="Barangay Sampaguita seal" decoding="async" />
