<%
  // The clinic's mark, in one place. Included by the rail, the topbar, the
  // landing page, both sign-in pages and the portal — so the badge can never
  // again be a letter in one place and a flower in another.
  //
  // A sampaguita, with a health cross where the yellow centre used to be. The
  // flower alone reads as decoration; the cross is what says "clinic" at 16px
  // to somebody who has never seen this system before.
  //
  // Drawn with five overlapping circles rather than petal outlines on purpose:
  // this is read at 16px in a browser tab, where any stroke thinner than about
  // 2px disappears. Big solid shapes survive being made tiny; delicate ones
  // turn to grey mush.
  //
  // `size` in px. `mono` fills the petals with currentColor instead of white,
  // for the places that sit on a coloured chip already.
  const size = typeof logoSize !== "undefined" ? logoSize : 32;
  const mono = typeof logoMono !== "undefined" && logoMono;
%><svg viewBox="0 0 32 32" width="<%= size %>" height="<%= size %>"
     role="img" aria-label="Sampaguita Health Clinic" focusable="false">
  <rect width="32" height="32" rx="<%= size <= 20 ? 7 : 8 %>" fill="<%= mono ? "currentColor" : "var(--accent)" %>"/>
  <g fill="<%= mono ? "var(--surface)" : "var(--on-accent, #fff)" %>" opacity=".92">
    <circle cx="16" cy="9.2" r="4.9"/>
    <circle cx="22.5" cy="13.9" r="4.9"/>
    <circle cx="20" cy="21.5" r="4.9"/>
    <circle cx="12" cy="21.5" r="4.9"/>
    <circle cx="9.5" cy="13.9" r="4.9"/>
  </g>
  <g fill="<%= mono ? "currentColor" : "var(--accent-strong)" %>">
    <rect x="14.6" y="11.6" width="2.8" height="8.8" rx="1.2"/>
    <rect x="11.6" y="14.6" width="8.8" height="2.8" rx="1.2"/>
  </g>
</svg>
