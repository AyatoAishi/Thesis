<%
  // A password box with a show/hide eye, in one place.
  //
  // The eye used to be hand-written into the staff sign-in page only, so the
  // people who most needed it — patients typing an unfamiliar password handed
  // to them at the desk, and the same patients changing it afterwards — were
  // the only ones typing blind. Any password input in the system should
  // include this instead of writing its own <input type="password">.
  //
  //   name          required — the field name the server reads
  //   id            optional — defaults to pw-<name>
  //   autocomplete  optional — "current-password" (default) or "new-password".
  //                 Getting this right matters: the browser fills a saved
  //                 password into anything it believes is a login box, which
  //                 silently overwrites what someone just typed.
  //   placeholder   optional
  //   required      optional — defaults to true
  //   minlength     optional
  const _name = name;
  const _id = typeof id !== "undefined" && id ? id : `pw-${name}`;
  const _ac = typeof autocomplete !== "undefined" && autocomplete ? autocomplete : "current-password";
  const _req = typeof required === "undefined" ? true : !!required;
  const _ph = typeof placeholder !== "undefined" && placeholder ? placeholder : "";
  const _min = typeof minlength !== "undefined" && minlength ? minlength : "";
%>
<div class="pw-wrap">
  <input type="password" name="<%= _name %>" id="<%= _id %>" autocomplete="<%= _ac %>"
         <% if (_req) { %>required<% } %>
         <% if (_min) { %>minlength="<%= _min %>"<% } %>
         <% if (_ph) { %>placeholder="<%= _ph %>"<% } %> />
  <button type="button" class="pw-toggle" data-pw-toggle aria-label="Show password">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/></svg>
  </button>
</div>
<script>
  /* One delegated listener for every eye on the page — the sign-in pages don't
     load app.js, and the change-password form has three of these at once. */
  if (!window.__pwToggleBound) {
    window.__pwToggleBound = true;
    document.addEventListener("click", function (e) {
      var btn = e.target.closest("[data-pw-toggle]");
      if (!btn) return;
      var input = btn.parentNode.querySelector("input");
      if (!input) return;
      var showing = input.type === "text";
      input.type = showing ? "password" : "text";
      btn.setAttribute("aria-label", showing ? "Show password" : "Hide password");
      btn.classList.toggle("is-on", !showing);
    });
  }
</script>
