<%
  // Thin wrapper over search-picker for the common "pick a patient" case.
  // Expects `patients` (rows with patient_id/full_name/patient_number) and an
  // optional `selectedId`.
  const _patientItems = (patients || []).map(p => ({
    id: p.patient_id, label: p.full_name, meta: p.patient_number,
  }));
%>
<%- include("search-picker", {
      items: _patientItems,
      name: "patient_id",
      selectedId: typeof selectedId !== "undefined" ? selectedId : "",
      placeholder: "Search by name or patient number…",
    }) %>
