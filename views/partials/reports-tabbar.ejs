<%
  // Third item: who may open it — "all" clinic roles (the medicine reports),
  // "report" roles (nurse, recorder, admin), or "admin" only for the reports
  // that list patients by name (panel review, Oct 2026). A tab somebody
  // cannot open is not shown to them — it would read as a broken page.
  const allTabs = [
    ["attendance", "Attendance", "report"],
    ["no-shows", "No-shows", "admin"],
    ["trend", "Seasonal trend", "report"],
    ["inventory", "Inventory", "all"],
    ["expired", "Expired medicines", "all"],
    ["stock-movements", "Stock history", "all"],
    ["consumption", "Medicines distributed", "all"],
    ["senior-citizen", "Senior citizen", "admin"],
    ["family-planning", "Family planning", "admin"],
    ["analytics", "Analytics", "report"],
  ];
  const _role = typeof user !== "undefined" && user ? user.role : "";
  const _ok = { all: true, report: ["nurse", "recorder", "admin"].includes(_role), admin: _role === "admin" };
  const tabs = allTabs.filter(t => _ok[t[2]]);
  // Carry whichever filter is in effect across tabs, so switching report
  // doesn't silently reset "This month" back to the default 30 days.
  const qs = (typeof period !== "undefined" && period)
    ? `?period=${period}`
    : `?from=${from}&to=${to}`;
%>
<div class="tabbar">
  <% tabs.forEach(t => { %>
    <a href="/reports/<%= t[0] %><%= qs %>" class="tab <%= active === t[0] ? 'active' : '' %>"><%= t[1] %></a>
  <% }) %>
</div>
