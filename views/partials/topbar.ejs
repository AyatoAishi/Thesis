<%
  const u = typeof user !== "undefined" && user ? user : null;
  const apptCount = typeof todayApptCount !== "undefined" ? todayApptCount : null;
  const todayPill = apptCount === null ? "—" : apptCount === 0 ? "No appointments today" : `${apptCount} appointment${apptCount === 1 ? "" : "s"} today`;
%>
<header class="topbar">
  <div class="brand">
    <span class="brand-badge">S</span>
    <span>Sampaguita&nbsp;HC</span>
  </div>

  <%# Typing shows matching patients right here and goes straight to the record.
      Submitting still falls back to the full /patients?q= list, so the search
      works the same with JavaScript off. %>
  <form class="search-form" action="/patients" method="GET" style="flex:1;min-width:0">
    <div class="search-wrap" data-topsearch>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-3.6-3.6"/></svg>
      <input class="search search-lg" type="search" name="q" data-search autocomplete="off"
             placeholder="Search patient by name or number…   (press / )" aria-label="Search patients" />
      <div class="topsearch-results" data-topsearch-results hidden></div>
    </div>
  </form>

  <div class="topbar-right">
    <span class="pill">● <%= todayPill %></span>

    <%
      // Things this role can act on right now. Empty is the normal state and
      // says so plainly — a bell that never resolves to "nothing to do" trains
      // people to stop looking at it.
      const bell = typeof alerts !== "undefined" && alerts ? alerts : [];
      const bellTotal = bell.reduce((n, a) => n + a.n, 0);
    %>
    <div class="bell" data-bell>
      <button type="button" class="icon-btn" data-bell-toggle
              title="Notifications" aria-label="Notifications"
              aria-expanded="false">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <% if (bellTotal) { %><span class="bell-dot"><%= bellTotal > 9 ? "9+" : bellTotal %></span><% } %>
      </button>
      <div class="bell-dropdown" data-bell-dropdown hidden>
        <div class="bell-title">Needs attention</div>
        <% if (!bell.length) { %>
          <div class="bell-empty">Nothing right now.</div>
        <% } else { %>
          <% bell.forEach(a => { %>
            <a class="bell-item" href="<%= a.href %>">
              <span class="bell-count"><%= a.n %></span>
              <span><%= a.label %></span>
            </a>
          <% }) %>
        <% } %>
      </div>
    </div>

    <% if (u) { %>
      <div class="user-menu" data-user-menu>
        <button type="button" class="user-chip" data-user-menu-toggle style="border:0;background:none;cursor:pointer">
          <span class="user-avatar"><%= (u.full_name || "?").charAt(0).toUpperCase() %></span>
          <span class="user-meta">
            <b><%= u.full_name %></b>
            <span><%= u.role %></span>
          </span>
        </button>
        <div class="user-menu-dropdown" data-user-menu-dropdown hidden>
          <a href="/account">Update profile</a>
          <a href="/account">Change password</a>
          <form method="POST" action="/logout" style="margin:0">
            <button type="submit" class="user-menu-logout">Logout</button>
          </form>
        </div>
      </div>
    <% } else { %>
      <div class="user-chip">
        <span class="user-avatar">·</span>
        <span class="user-meta"><b>Not signed in</b></span>
      </div>
    <% } %>
  </div>
</header>

<script>
  (function () {
    var menu = document.querySelector("[data-user-menu]");
    if (menu) {
      var toggle = menu.querySelector("[data-user-menu-toggle]");
      var dropdown = menu.querySelector("[data-user-menu-dropdown]");
      toggle.addEventListener("click", function (e) {
        e.stopPropagation();
        dropdown.hidden = !dropdown.hidden;
      });
      document.addEventListener("click", function (e) {
        if (!menu.contains(e.target)) dropdown.hidden = true;
      });
    }
    var bell = document.querySelector("[data-bell]");
    if (bell) {
      var bellBtn = bell.querySelector("[data-bell-toggle]");
      var bellBox = bell.querySelector("[data-bell-dropdown]");
      bellBtn.addEventListener("click", function (e) {
        e.stopPropagation();
        bellBox.hidden = !bellBox.hidden;
        bellBtn.setAttribute("aria-expanded", String(!bellBox.hidden));
      });
      document.addEventListener("click", function (e) {
        if (!bell.contains(e.target)) {
          bellBox.hidden = true;
          bellBtn.setAttribute("aria-expanded", "false");
        }
      });
    }
    var search = document.querySelector("[data-search]");
    if (search) {
      document.addEventListener("keydown", function (e) {
        if (e.key === "/" && document.activeElement !== search &&
            !/^(INPUT|TEXTAREA|SELECT)$/.test((document.activeElement || {}).tagName)) {
          e.preventDefault();
          search.focus();
        }
      });
    }
  })();
</script>
