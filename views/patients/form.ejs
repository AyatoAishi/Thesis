<%
  const isEdit = mode === "edit";
  const p = patient || {};
  const action = isEdit ? `/patients/${p.patient_id}` : "/patients";
  // The database hands dates back as "YYYY-MM-DD" text (db/index.js). Taken as
  // text, never through new Date(): a bad value typed into a hand-made request
  // would make toISOString() throw and take the whole form down with it.
  const bd = /^\d{4}-\d{2}-\d{2}$/.test(String(p.birthdate || "")) ? String(p.birthdate)
           : p.birthdate instanceof Date ? p.birthdate.toISOString().slice(0, 10) : "";
  // No birthdates in the future (the Sept 29 review found one) or before 1900.
  const todayISO = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Manila" }).format(new Date());
  // Anything already saved that isn't one of the preset relations (free text
  // from before the dropdown existed) reopens as "Other" with the old wording
  // kept, so editing a patient never silently wipes it.
  const rel = p.family_contact_relation || "";
  const relIsPreset = relations.includes(rel);
  const chain = typeof next !== "undefined" ? next : "";
%>
<%- include("../partials/back", { href: isEdit ? `/patients/${p.patient_id}` : "/patients", to: "Back" }) %>
<div class="page-head">
  <h1><%= isEdit ? "Edit patient" : "Add patient" %></h1>
</div>

<%# Alyanna (Oct 2026): the step bar shows from the first page of Add patient,
    not only when coming from Appointments. Step 3 follows the purpose picked
    below (script at the bottom). %>
<% if (!isEdit) { %>
  <%- include("../partials/flow-steps", { step: 1 }) %>
<% } %>

<% if (errors && errors.length) { %>
  <div class="card" style="border-color:var(--bad);background:var(--bad-bg)">
    <b style="color:var(--bad-ink)">Please fix:</b>
    <ul style="margin:8px 0 0;color:var(--bad-ink);font-size:13px">
      <% errors.forEach(e => { %><li><%= e %></li><% }) %>
    </ul>
  </div>
<% } %>

<%
  // Somebody already on file who may be this same person. A warning, never a
  // block: two people in a barangay really can share a name, and twins share a
  // birthdate too. But the same patient registered twice splits their history
  // across two records and nothing will ever join it back up, so continuing is
  // made a decision rather than a silence.
  const twins = typeof lookalikes !== "undefined" && lookalikes ? lookalikes : [];
%>
<% if (twins.length) { %>
  <div class="card" style="border-color:var(--warn);background:var(--warn-bg)">
    <b style="color:var(--warn-ink)">
      <%= twins.length === 1 ? "Somebody with this name is already on file" : "People with this name are already on file" %>
    </b>
    <p style="margin:7px 0 0;font-size:13px;color:var(--ink-2);line-height:1.55">
      Nothing has been saved yet. Check whether this is the same person — if it
      is, open their record instead of making a second one, or their visits and
      doses end up split between two files.
    </p>
    <div class="status-list" style="margin-top:11px">
      <% twins.forEach(function (t) { %>
        <div class="status-row">
          <div class="status-label">
            <b><%= t.full_name %></b> · <span class="mono"><%= t.patient_number %></span>
            <small>
              <%= t.birthdate ? new Date(t.birthdate).toLocaleDateString("en-PH", { timeZone: "Asia/Manila", year: "numeric", month: "long", day: "numeric" }) : "no birthdate on file" %><%
              %><%= t.contact_number ? " · " + t.contact_number : "" %>
            </small>
          </div>
          <a class="mini-btn" href="/patients/<%= t.patient_id %>" target="_blank" rel="noopener">Open record</a>
        </div>
      <% }) %>
    </div>
    <p style="margin:12px 0 0;font-size:12.5px;color:var(--ink-3)">
      Really a different person? Press <b>Save anyway</b> at the bottom.
    </p>
  </div>
<% } %>

<form method="POST" action="<%= action %>"><%- include("../partials/csrf") %>
  <% if (chain) { %><input type="hidden" name="next" value="<%= chain %>" /><% } %>
  <%# Only present on the second pass, after the warning above has been read. %>
  <% if (twins.length) { %><input type="hidden" name="confirm_duplicate" value="yes" /><% } %>
  <%# When this form was loaded, so the server can refuse to save on top of a
      change someone else made while it sat open — see routes/patients.js. %>
  <% if (isEdit && p.updated_at) { %>
    <input type="hidden" name="seen_at" value="<%= new Date(p.updated_at).toISOString() %>" />
  <% } %>
  <%# Panel review, Oct 2026: basic information first, then why the patient
      came, then how to reach them — each in its own titled section. %>
  <div class="card">
    <div class="panel-title" style="margin-bottom:4px">Basic information</div>
    <%# "What does the asterisk mean on the Guardian name?" (Sept 29) — the form
        never said. %>
    <p class="muted req-note">Fields marked <b class="req">*</b> are required.</p>
    <div class="form-grid">
      <%# The name in three parts (Sept 29). full_name is built from them on save
          and is still what every list, report and PDF shows. %>
      <div class="name-grid" style="grid-column:1/-1">
        <label class="field"><span>First name *</span>
          <input type="text" name="first_name" value="<%= p.first_name || '' %>" maxlength="80" required autocomplete="off" />
        </label>
        <label class="field"><span>Middle name</span>
          <input type="text" name="middle_name" value="<%= p.middle_name || '' %>" maxlength="80" autocomplete="off" />
        </label>
        <label class="field"><span>Last name *</span>
          <input type="text" name="last_name" value="<%= p.last_name || '' %>" maxlength="80" required autocomplete="off" />
        </label>
      </div>
      <% if (p.name_guessed) { %>
        <p class="name-guess" style="grid-column:1/-1">
          This record was saved as one name, <b>“<%= p.full_name %>”</b>. It has been split into the
          three boxes above — check that each part is in the right box, then save.
        </p>
      <% } %>
      <label class="field"><span>Birthdate</span>
        <input type="date" name="birthdate" value="<%= bd %>" min="1900-01-01" max="<%= todayISO %>" />
      </label>
      <label class="field"><span>Sex</span>
        <select name="sex">
          <option value="">—</option>
          <option value="male"   <%= p.sex === 'male'   ? 'selected' : '' %>>Male</option>
          <option value="female" <%= p.sex === 'female' ? 'selected' : '' %>>Female</option>
        </select>
      </label>
      <label class="field" style="grid-column:1/-1"><span>Address</span>
        <input type="text" name="address" value="<%= p.address || '' %>" />
      </label>
    </div>
  </div>

  <% if (!isEdit) { %>
    <%# Why the patient came (panel review). Picking one takes staff straight to
        that screen after saving — booking, the prenatal record, dispensing or
        the consultation — through lib/visitPurpose.js. Nothing is stored. %>
    <%
      const purposeList = typeof purposes !== "undefined" ? purposes : [];
      const purposeSel = typeof purpose !== "undefined" && purpose ? purpose : (chain === "book" ? "book" : "");
    %>
    <div class="card">
      <div class="panel-title" style="margin-bottom:4px">Purpose of visit</div>
      <p class="muted" style="font-size:12.5px;margin:0 0 10px">What did the patient come to the clinic for today? After saving, the system opens that next step.</p>
      <div class="purpose-grid">
        <% purposeList.forEach(function (o) { %>
          <label class="check-inline">
            <input type="radio" name="purpose" value="<%= o.key %>" data-step-label="<%= o.step %>" <%= purposeSel === o.key ? "checked" : "" %> />
            <span><b><%= o.label %></b></span>
          </label>
        <% }) %>
        <label class="check-inline">
          <input type="radio" name="purpose" value="" data-step-label="Patient's page" <%= purposeSel ? "" : "checked" %> />
          <span><b>Just registering</b><small>Save and open the patient's page.</small></span>
        </label>
      </div>
    </div>
  <% } %>

  <%# One choice instead of two checkboxes (panel review): how this patient can
      be reached. "No contact at all" was taken out after the system defense
      (Alyanna, Oct 2026): a patient with no phone is reached through the
      emergency contact anyway, so every record now needs one of the two
      numbers. An old record saved as "no contact" opens as "no phone". %>
  <%
    const contactMode = p.contact_mode === "own" || p.contact_mode === "emergency" ? p.contact_mode
      : p.no_contact || (!p.contact_number && p.family_contact_number) || p.no_own_phone ? "emergency" : "own";
  %>
  <div class="card">
    <div class="panel-title" style="margin-bottom:10px">Contact information</div>
    <div class="contact-mode" role="radiogroup" aria-label="How to reach this patient">
      <label class="check-inline">
        <input type="radio" name="contact_mode" value="own" data-contact-mode <%= contactMode === "own" ? "checked" : "" %> />
        <span><b>Has their own phone</b><small>Reminders go to the patient's own number.</small></span>
      </label>
      <label class="check-inline">
        <input type="radio" name="contact_mode" value="emergency" data-contact-mode <%= contactMode === "emergency" ? "checked" : "" %> />
        <span><b><%= t("pat.no_phone") %></b><small><%= t("pat.no_phone_hint") %></small></span>
      </label>
    </div>
    <div class="form-grid" style="margin-top:12px">
      <label class="field"><span>Mobile number</span>
        <input type="tel" name="contact_number" value="<%= p.contact_number || '' %>" placeholder="09xxxxxxxxx"
               inputmode="numeric" maxlength="16" pattern="09[0-9]{9}" title="11 digits: 09xxxxxxxxx" data-digits data-phone-primary data-contact-field />
        <span class="muted" style="font-size:11.5px;font-weight:500" data-phone-hint>11 digits, e.g. 09171234567</span>
      </label>
      <label class="field"><span>Email <span class="muted">(for reminders)</span></span>
        <input type="email" name="email" value="<%= p.email || '' %>" placeholder="name@gmail.com" data-contact-field data-own-email />
      </label>
      <label class="field" style="grid-column:1/-1"><span>How to remind this patient</span>
        <% const rc = p.reminder_channel || 'both'; %>
        <select name="reminder_channel" data-reminder-select>
          <option value="both"  <%= rc === 'both'  ? 'selected' : '' %>>Email and SMS</option>
          <option value="email" <%= rc === 'email' ? 'selected' : '' %>>Email only</option>
          <option value="sms"   <%= rc === 'sms'   ? 'selected' : '' %>>SMS only</option>
          <option value="none"  <%= rc === 'none'  ? 'selected' : '' %>>Do not send reminders</option>
        </select>
        <span class="muted" style="font-size:11.5px;font-weight:500">
          Adults: their own number/email first, the emergency contact if they have none.
          Minors: the emergency contact (the guardian) gets the reminders first.
          <% if (typeof smsLive !== "undefined" && !smsLive) { %>SMS is not connected to a provider yet, so those are recorded but not actually sent.<% } %>
        </span>
      </label>
    </div>
  </div>

  <% if (isEdit) { %>
    <%# Linking relatives happens here and on the Family records page — not on
        the registration form (panel review, Oct 2026: "remove the optional add
        to family upon registering a patient"). %>
    <div class="card" style="overflow:visible">
      <div class="panel-title" style="margin-bottom:6px">Family <span class="muted" style="font-weight:500">(optional)</span></div>
      <p class="muted" style="font-size:12.5px;margin:0 0 12px">If this patient has family already registered in the system, search for them below — this groups them together automatically. Leave it blank if they have none, or if you do not know yet.</p>
      <%- include("../partials/family-lookup", { familyLookup, familyMembers, patient: p }) %>
    </div>
  <% } %>

  <div class="card">
    <div class="panel-title" style="margin-bottom:6px">Emergency / family contact <span class="muted">(required if the patient has no phone of their own)</span></div>
    <p class="muted" style="margin:0 0 10px;font-size:12.5px;<%= p.is_minor ? '' : 'display:none' %>" data-minor-only>
      <b>This patient is a minor</b> (from the birthdate) — the emergency contact # is required. Put the parent's or guardian's number here; the child's reminders go to it.
    </p>
    <div class="form-grid">
      <label class="field"><span>Name</span>
        <input type="text" name="family_contact_name" value="<%= p.family_contact_name || '' %>" />
      </label>
      <label class="field"><span>Relation</span>
        <select name="family_contact_relation" data-relation-select>
          <option value="">—</option>
          <% relations.forEach(r => { %>
            <option value="<%= r %>" <%= rel === r ? 'selected' : '' %>><%= r %></option>
          <% }) %>
          <option value="__other__" <%= rel && !relIsPreset ? 'selected' : '' %>>Other…</option>
        </select>
        <input type="text" name="family_contact_relation_other" data-relation-other
               value="<%= relIsPreset ? '' : rel %>" placeholder="Type the relation"
               style="<%= rel && !relIsPreset ? 'margin-top:6px' : 'display:none' %>" />
      </label>
      <label class="field"><span>Contact #</span>
        <input type="tel" name="family_contact_number" value="<%= p.family_contact_number || '' %>" placeholder="09xxxxxxxxx"
               inputmode="numeric" maxlength="16" pattern="09[0-9]{9}" title="11 digits: 09xxxxxxxxx" data-digits data-phone-fallback data-contact-field />
        <span class="muted" style="font-size:11.5px;font-weight:500">11 digits, e.g. 09171234567</span>
      </label>
      <label class="field"><span>Emergency contact email <span class="muted">(optional)</span></span>
        <input type="email" name="family_email" value="<%= p.family_email || '' %>" placeholder="name@gmail.com" data-contact-field />
      </label>
    </div>
  </div>

  <%# Guardian details are no longer asked on Add patient (Alyanna, Oct 2026).
      They stay here on Edit, optional, for a minor whose immunization card
      should show the mother's or father's name. %>
  <% if (isEdit) { %>
  <div class="card" data-minor-fields style="<%= p.is_minor ? '' : 'display:none' %>">
    <div class="panel-title" style="margin-bottom:4px">Parents / guardian <span class="muted" style="font-weight:500">(optional)</span></div>
    <p class="muted" style="margin:0 0 10px;font-size:12.5px">Shown on the child's immunization card.</p>
    <div class="minor-fields">
      <div class="form-grid">
        <label class="field"><span>Mother's name</span>
          <input type="text" name="mother_name" maxlength="150" value="<%= p.mother_name || '' %>" />
        </label>
        <label class="field"><span>Father's name</span>
          <input type="text" name="father_name" maxlength="150" value="<%= p.father_name || '' %>" />
        </label>
        <label class="field"><span>Guardian name <span class="muted">(if not the mother or father)</span></span>
          <input type="text" name="guardian_name" value="<%= p.guardian_name || '' %>" />
        </label>
      </div>
    </div>
  </div>
  <% } %>

  <div class="card">
    <label class="check">
      <input type="checkbox" name="privacy_consent" required <%= p.privacy_consent ? 'checked' : '' %> />
      <span>Patient (or guardian) agrees to the clinic's <b>data privacy disclosure</b> — records are collected and stored per RA 10173. *<br />
        <a class="legal-link" href="/privacy" target="_blank" rel="noopener">Read the Privacy Notice →</a></span>
    </label>
  </div>

  <%# The label changes on the second pass so it is clear what is being agreed
      to — pressing "Create patient" again after a warning reads like the first
      press simply failed. %>
  <button type="submit" class="btn">
    <%= twins.length ? "Save anyway — this is a different person" : (isEdit ? "Save changes" : "Create patient") %>
  </button>
</form>

<script>
  // Show/hide guardian fields as soon as the birthdate implies "under 18"
  // (the server is the source of truth — this is just for a smoother form).
  (function () {
    var bdInput = document.querySelector('input[name="birthdate"]');
    var fields = document.querySelector("[data-minor-fields]");
    var minorOnly = document.querySelector("[data-minor-only]");
    function isMinor(dateStr) {
      if (!dateStr) return false;
      var bd = new Date(dateStr + "T00:00:00");
      var today = new Date();
      var age = today.getFullYear() - bd.getFullYear();
      var m = today.getMonth() - bd.getMonth();
      if (m < 0 || (m === 0 && today.getDate() < bd.getDate())) age--;
      return age < 18;
    }
    function sync() {
      var minor = bdInput ? isMinor(bdInput.value) : false;
      if (fields) fields.style.display = minor ? "" : "none";
      if (minorOnly) minorOnly.style.display = minor ? "" : "none";
      document.dispatchEvent(new Event("patient-form-sync"));
    }
    if (bdInput) bdInput.addEventListener("change", sync);
    sync();
  })();

  // Contact numbers: strip anything that isn't a digit as it's typed, so a
  // pasted "(0917) 123-4567" cleans itself up instead of bouncing back as a
  // validation error the person has to re-read.
  (function () {
    // Digits only, a pasted +63 folded to a leading 0, and capped at 11 — the
    // same rule lib/phone.js applies on the server, so what the box shows is
    // what gets saved. maxlength is 16 rather than 11 on purpose: the browser
    // would truncate "+639171234567" to 11 characters BEFORE this runs and
    // lose the last two digits.
    document.querySelectorAll("[data-digits]").forEach(function (input) {
      input.addEventListener("input", function () {
        var cleaned = input.value.replace(/\D/g, "");
        if (cleaned.length >= 12 && cleaned.indexOf("639") === 0) cleaned = "0" + cleaned.slice(2);
        if (cleaned.length > 11) cleaned = cleaned.slice(0, 11);
        if (cleaned !== input.value) {
          var drop = input.value.length - cleaned.length;
          var pos = Math.max(0, (input.selectionStart || 0) - drop);
          input.value = cleaned;
          try { input.setSelectionRange(pos, pos); } catch (e) {}
        }
      });
    });

    // One choice for how the patient is reached (panel review, Oct 2026):
    //   own        — the patient's own number (or the emergency contact's, if
    //                the patient's box is left empty: the server's rule).
    //   emergency  — no phone of their own: their box is greyed and the
    //                emergency contact # becomes the required one.
    // ("No contact at all" was removed after the system defense.)
    // A minor always needs the emergency contact # (the guardian's).
    var primary = document.querySelector("[data-phone-primary]");
    var fallback = document.querySelector("[data-phone-fallback]");
    var hint = document.querySelector("[data-phone-hint]");
    var reminder = document.querySelector("[data-reminder-select]");
    var modes = document.querySelectorAll("[data-contact-mode]");
    function mode() {
      var m = "own";
      modes.forEach(function (r) { if (r.checked) m = r.value; });
      return m;
    }
    function sync() {
      var m = mode();
      var minorNote = document.querySelector("[data-minor-only]");
      var minor = !!(minorNote && minorNote.style.display !== "none");
      document.querySelectorAll("[data-contact-field]").forEach(function (f) {
        var off = m === "emergency" && f === primary;
        f.disabled = off;
        if (off) f.value = "";
        var wrap = f.closest(".field");
        if (wrap) wrap.style.opacity = off ? "0.45" : "";
      });
      if (fallback) fallback.required = m === "emergency" || minor;
      if (hint) hint.textContent = m === "emergency" ? "Sa emergency contact # ipapadala." : "11 digits, e.g. 09171234567";
    }
    modes.forEach(function (r) { r.addEventListener("change", sync); });
    document.addEventListener("patient-form-sync", sync);
    sync();
  })();

  // Step bar: step 3 names where the chosen purpose of visit leads.
  (function () {
    var last = document.querySelector(".flow-steps .flow-step:last-child .flow-step-label");
    var radios = document.querySelectorAll("input[name=purpose][data-step-label]");
    if (!last || !radios.length) return;
    function sync() {
      radios.forEach(function (r) { if (r.checked) last.textContent = r.getAttribute("data-step-label"); });
    }
    radios.forEach(function (r) { r.addEventListener("change", sync); });
    sync();
  })();

  // Relation dropdown: "Other…" reveals a free-text box beside it.
  (function () {
    var select = document.querySelector("[data-relation-select]");
    var other = document.querySelector("[data-relation-other]");
    if (!select || !other) return;
    select.addEventListener("change", function () {
      var isOther = select.value === "__other__";
      other.style.display = isOther ? "" : "none";
      other.style.marginTop = isOther ? "6px" : "";
      if (isOther) other.focus();
      else other.value = "";
    });
  })();
</script>
