<%
  const isEdit = mode === "edit";
  const p = patient || {};
  const action = isEdit ? `/patients/${p.patient_id}` : "/patients";
  const bd = p.birthdate ? new Date(p.birthdate).toISOString().slice(0, 10) : "";
%>
<div class="page-head">
  <h1><%= isEdit ? "Edit patient" : "Add patient" %></h1>
  <div class="sub"><a href="/patients" class="back-link">← Back to patients</a></div>
</div>

<% if (errors && errors.length) { %>
  <div class="card" style="border-color:#f3c9cb;background:var(--bad-bg)">
    <b style="color:var(--bad-ink)">Please fix:</b>
    <ul style="margin:8px 0 0;color:var(--bad-ink);font-size:13px">
      <% errors.forEach(e => { %><li><%= e %></li><% }) %>
    </ul>
  </div>
<% } %>

<form method="POST" action="<%= action %>">
  <div class="card">
    <div class="panel-title" style="margin-bottom:14px">Patient details</div>
    <div class="form-grid">
      <label class="field"><span>Full name *</span>
        <input type="text" name="full_name" value="<%= p.full_name || '' %>" required />
      </label>
      <label class="field"><span>Birthdate</span>
        <input type="date" name="birthdate" value="<%= bd %>" />
      </label>
      <label class="field"><span>Sex</span>
        <select name="sex">
          <option value="">—</option>
          <option value="male"   <%= p.sex === 'male'   ? 'selected' : '' %>>Male</option>
          <option value="female" <%= p.sex === 'female' ? 'selected' : '' %>>Female</option>
        </select>
      </label>
      <label class="field"><span>Patient contact #</span>
        <input type="text" name="contact_number" value="<%= p.contact_number || '' %>" placeholder="09xxxxxxxxx" />
      </label>
      <label class="field"><span>Patient email <span class="muted">(for reminders)</span></span>
        <input type="email" name="email" value="<%= p.email || '' %>" placeholder="name@gmail.com" />
      </label>
      <label class="field" style="grid-column:1/-1"><span>Address</span>
        <input type="text" name="address" value="<%= p.address || '' %>" />
      </label>
    </div>
  </div>

  <div class="card" style="overflow:visible">
    <div class="panel-title" style="margin-bottom:6px">Family</div>
    <p class="muted" style="font-size:12.5px;margin:0 0 12px">If this patient has family already registered in the system, search for them below — this groups them together automatically.</p>
    <%- include("../partials/family-lookup", { familyLookup, familyMembers, patient: p }) %>
  </div>

  <div class="card">
    <div class="panel-title" style="margin-bottom:6px">Emergency / family contact <span class="muted">(required if the patient has no phone of their own)</span></div>
    <div class="form-grid">
      <label class="field"><span>Name</span>
        <input type="text" name="family_contact_name" value="<%= p.family_contact_name || '' %>" />
      </label>
      <label class="field"><span>Relation</span>
        <input type="text" name="family_contact_relation" value="<%= p.family_contact_relation || '' %>" placeholder="e.g. mother" />
      </label>
      <label class="field"><span>Contact #</span>
        <input type="text" name="family_contact_number" value="<%= p.family_contact_number || '' %>" placeholder="09xxxxxxxxx" />
      </label>
      <label class="field"><span>Emergency contact email <span class="muted">(optional)</span></span>
        <input type="email" name="family_email" value="<%= p.family_email || '' %>" placeholder="name@gmail.com" />
      </label>
    </div>
  </div>

  <div class="card">
    <div class="panel-title" style="margin-bottom:4px">Guardian details</div>
    <p class="muted" style="margin:0 0 10px;font-size:13px" data-minor-note>
      Minor status is calculated automatically from the birthdate above.
    </p>
    <div class="minor-fields" data-minor-fields style="<%= p.is_minor ? '' : 'display:none' %>">
      <div class="form-grid">
        <label class="field"><span>Guardian name *</span>
          <input type="text" name="guardian_name" value="<%= p.guardian_name || '' %>" />
        </label>
      </div>
      <label class="check" style="margin-top:12px">
        <input type="checkbox" name="guardian_consent" <%= p.guardian_consent ? 'checked' : '' %> />
        <span>Guardian <b>consent</b> recorded for treatment &amp; data handling (RA 10173)</span>
      </label>
    </div>
  </div>

  <div class="card">
    <label class="check">
      <input type="checkbox" name="privacy_consent" required <%= p.privacy_consent ? 'checked' : '' %> />
      <span>Patient (or guardian) agrees to the clinic's <b>data privacy disclosure</b> — records are collected and stored per RA 10173. *</span>
    </label>
  </div>

  <button type="submit" class="btn"><%= isEdit ? "Save changes" : "Create patient" %></button>
</form>

<script>
  // Show/hide guardian fields as soon as the birthdate implies "under 18"
  // (the server is the source of truth — this is just for a smoother form).
  (function () {
    var bdInput = document.querySelector('input[name="birthdate"]');
    var fields = document.querySelector("[data-minor-fields]");
    function isMinor(dateStr) {
      if (!dateStr) return false;
      var bd = new Date(dateStr + "T00:00:00");
      var today = new Date();
      var age = today.getFullYear() - bd.getFullYear();
      var m = today.getMonth() - bd.getMonth();
      if (m < 0 || (m === 0 && today.getDate() < bd.getDate())) age--;
      return age < 18;
    }
    function sync() {
      if (bdInput && fields) fields.style.display = isMinor(bdInput.value) ? "" : "none";
    }
    if (bdInput) bdInput.addEventListener("change", sync);
    sync();
  })();
</script>
