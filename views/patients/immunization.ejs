<%
  function fmtDate(d) { return d ? new Date(d).toLocaleDateString("en-PH", { year: "numeric", month: "short", day: "numeric" }) : "—"; }
  const CATS = [
    ["infant", "Infant"],
    ["school", "School-aged children"],
    ["senior", "Senior citizen"],
  ];
  // An empty slot used to look the same whether the dose was due at birth and
  // never given, or due next March. These are the words for the difference.
  // The state itself is worked out in lib/immunizationCard.js.
  const SLOT = {
    overdue:  { cls: "bad",  word: "overdue" },
    due:      { cls: "warn", word: "due now" },
    upcoming: { cls: "info", word: "upcoming" },
  };
  function slotLabel(slot) {
    if (slot.state === "overdue") {
      return `${slot.daysOverdue} day${slot.daysOverdue === 1 ? "" : "s"} overdue`;
    }
    if (slot.state === "due") return "due today";
    if (slot.state === "upcoming") return `due ${fmtDate(slot.dueDate)}`;
    return "";
  }
%>
<%- include("../partials/back", { href: back || `/patients/${patient.patient_id}`, to: "Back to the patient" }) %>
<div class="page-head" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
  <div>
    <h1><%= patient.full_name %> — Immunization</h1>
    <div class="sub mono"><%= patient.patient_number %></div>
  </div>
  <div style="display:flex;gap:8px">
    <a class="mini-btn" href="/patients/<%= patient.patient_id %>/immunization/export" target="_blank" rel="noopener">Export PDF</a>
    <a class="btn" href="/patients/<%= patient.patient_id %>/immunization/new<%= back ? "?back=" + encodeURIComponent(back) : "" %>">+ Record a dose</a>
  </div>
</div>

<%
  // Whose child this is, and who actually gets the reminder. A baby has no
  // phone, email or portal account of its own, so the reminder goes where
  // services/reminders.js sends it: the patient's own number/email first, then
  // the emergency/family contact's. Shown here because "how does the reminder
  // reach a baby?" was a real question from our own group (Richelle, Sept 26)
  // — if we had to ask, a nurse will too. This card is shown for minors only,
  // and for a minor services/reminders.js tries the emergency contact (the
  // parent or guardian) FIRST — so the same order here.
  const _smsTo = patient.family_contact_number
    ? { to: patient.family_contact_number, who: patient.family_contact_name || "the emergency contact" }
    : patient.contact_number
      ? { to: patient.contact_number, who: "the patient's own number" }
      : null;
  const _mailTo = patient.family_email || patient.email || null;
%>
<% if (patient.is_minor) { %>
  <div class="card parents-card">
    <dl class="kv">
      <div><dt>Mother</dt><dd><b><%= patient.mother_name || "—" %></b></dd></div>
      <div><dt>Father</dt><dd><b><%= patient.father_name || "—" %></b></dd></div>
      <% if (patient.guardian_name) { %><div><dt>Guardian</dt><dd><%= patient.guardian_name %></dd></div><% } %>
      <div><dt>Reminders go to</dt><dd>
        <% if (_smsTo || _mailTo) { %>
          <%= [_smsTo && `${_smsTo.to} (${_smsTo.who})`, _mailTo].filter(Boolean).join(" · ") %>
        <% } else { %>
          <span class="badge bad">Nobody</span> — no number or email on this record.
        <% } %>
      </dd></div>
    </dl>
    <% if (!patient.mother_name && !patient.father_name || !_smsTo && !_mailTo) { %>
      <p class="muted" style="margin:8px 0 0;font-size:12.5px">
        <a href="/patients/<%= patient.patient_id %>/edit">Edit the patient</a> to add the parents<%= !_smsTo && !_mailTo ? " and a parent's number under Emergency contact" : "" %>.
      </p>
    <% } %>
  </div>
<% } %>

<% if (flash) { %>
  <div class="card" style="background:var(--accent-softer);border-color:var(--accent-soft)"><%= flash %></div>
<% } %>

<% if (overdue.length) { %>
  <div class="card" style="border-color:var(--bad-bg);background:var(--bad-bg)">
    <b style="color:var(--bad-ink)"><%= overdue.length %> dose<%= overdue.length === 1 ? "" : "s" %> overdue</b>
    <span style="color:var(--bad-ink);font-size:13px">
      — the oldest by <%= overdue[0].daysOverdue %> day<%= overdue[0].daysOverdue === 1 ? "" : "s" %>.
      <% if (overdue.some(d => d.bookedFor)) { %>
        The ones with a date beside them are already booked into a session.
      <% } else { %>
        None of them are booked yet.
      <% } %>
    </span>
  </div>
<% } else if (upcoming.length) { %>
  <div class="card">
    <b>Next due</b>
    <span class="muted" style="font-size:13px">
      — <%= upcoming[0].vaccine %> dose <%= upcoming[0].doseNumber %> on <%= fmtDate(upcoming[0].dueDate) %><%
      %><% if (upcoming[0].bookedFor) { %>, booked for <%= fmtDate(upcoming[0].bookedFor) %><% } %>.
    </span>
  </div>
<% } %>

<% CATS.forEach(([catKey, catLabel]) => { %>
  <% const rows = schedule.filter(v => v.category === catKey); %>
  <% if (rows.length) { %>
    <div class="card">
      <div class="panel-title" style="margin-bottom:12px"><%= catLabel %></div>
      <table class="tbl">
        <thead><tr><th>Vaccine</th><th>Schedule</th><th>Doses</th></tr></thead>
        <tbody>
          <% rows.forEach(v => { %>
            <tr>
              <td>
                <%= v.name %>
                <%# What the letters stand for (panel review: staff may not know the acronyms). %>
                <% const _help = { "BCG Vaccine": "Bacillus Calmette–Guérin: protects against tuberculosis (TB)",
                                   "Pentavalent Vaccine (DPT-Hep B-HIB)": "Diphtheria, pertussis, tetanus, hepatitis B and Haemophilus influenzae type b",
                                   "Pneumococcal Conjugate Vaccine (PCV)": "Protects against pneumonia and meningitis",
                                   "Measles Containing Vaccine (MCV) — Grade 1": "Measles booster at school entry",
                                   "Measles Containing Vaccine (MCV) — Grade 7": "Measles booster in Grade 7",
                                   "Human Papillomavirus Vaccine": "HPV: protects against cervical cancer" }[v.name]; %>
                <% if (_help) { %><div class="muted" style="font-size:11.5px;font-weight:500"><%= _help %></div><% } %>
              </td>
              <td class="muted"><%= v.schedule %></td>
              <td>
                <div style="display:flex;gap:10px;flex-wrap:wrap">
                  <% v.doseSlots.forEach(slot => { %>
                    <% if (slot.given) { %>
                      <span class="badge ok" title="<%= slot.remarks || '' %>">
                        Dose <%= slot.doseNumber %>: <%= fmtDate(slot.date) %>
                      </span>
                    <% } else { %>
                      <span style="display:inline-flex;align-items:center;gap:6px">
                        <a class="mini-btn" style="padding:2px 8px;font-size:11px"
                           href="/patients/<%= patient.patient_id %>/immunization/new?vaccine=<%= encodeURIComponent(v.name) %>&dose=<%= slot.doseNumber %><%= back ? "&back=" + encodeURIComponent(back) : "" %>">
                          Dose <%= slot.doseNumber %>: Record
                        </a>
                        <% if (SLOT[slot.state]) { %>
                          <span class="badge <%= SLOT[slot.state].cls %>" style="font-size:11px;padding:2px 8px"
                                title="Due <%= fmtDate(slot.dueDate) %>"><%= slotLabel(slot) %></span>
                        <% } %>
                        <% if (slot.bookedFor) { %>
                          <span class="muted" style="font-size:11px">booked <%= fmtDate(slot.bookedFor) %></span>
                        <% } %>
                      </span>
                    <% } %>
                  <% }) %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
<% }) %>

<div class="card">
  <div class="panel-title" style="margin-bottom:12px">Other vaccines given</div>
  <% if (!other.length) { %>
    <p class="muted" style="margin:0">None recorded. Use <b>+ Record a dose</b> and choose "Other" for anything not on the standard schedule above.</p>
  <% } else { %>
    <table class="tbl">
      <thead><tr><th>Vaccine</th><th>Dose</th><th>Date given</th><th>Remarks</th></tr></thead>
      <tbody>
        <% other.forEach(r => { %>
          <tr>
            <td><%= r.vaccine_name %></td>
            <td><%= r.dose_number %></td>
            <td><%= fmtDate(r.given_date) %></td>
            <td class="muted"><%= r.remarks || "—" %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
