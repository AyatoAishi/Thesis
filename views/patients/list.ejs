<%
  function age(bd) {
    if (!bd) return "—";
    const d = new Date(bd), n = new Date();
    let a = n.getFullYear() - d.getFullYear();
    const m = n.getMonth() - d.getMonth();
    if (m < 0 || (m === 0 && n.getDate() < d.getDate())) a--;
    return a;
  }

  // Households, built from the rows the server already ordered (shared number
  // first, oldest member first inside it). The number itself never reaches the
  // screen — staff know families by name, so each group is titled after its
  // oldest adult, with everyone else listed under them.
  function household(list) {
    const groups = new Map();
    const loose = [];
    list.forEach((p) => {
      if (!p.family_number) return loose.push(p);
      if (!groups.has(p.family_number)) groups.set(p.family_number, []);
      groups.get(p.family_number).push(p);
    });
    const out = [];
    groups.forEach((members) => {
      const head = members.find((m) => !m.is_minor) || members[0];
      out.push({ head, members });
    });
    out.sort((a, b) => (a.head.full_name.toLowerCase() < b.head.full_name.toLowerCase() ? -1 : 1));
    return { groups: out, loose };
  }

  // The same page, switched to table or cards. Keeps the search, sort, tab and
  // the overdue filter exactly as they are.
  function layoutLink(l) {
    const parts = ["layout=" + l];
    if (q) parts.push("q=" + encodeURIComponent(q));
    if (sort && sort !== "newest") parts.push("sort=" + encodeURIComponent(sort));
    if (view === "household") parts.push("view=household");
    if (overdueOnly) parts.push("overdue=1");
    return "/patients?" + parts.join("&");
  }

  // Keeps the search box and sort choice when flipping between the two views.
  function viewLink(v, keepOverdue) {
    const parts = [];
    if (q) parts.push("q=" + encodeURIComponent(q));
    if (sort && sort !== "newest") parts.push("sort=" + encodeURIComponent(sort));
    if (v === "household") parts.push("view=household");
    // Carried across the tabs, so choosing "By household" does not silently
    // drop the filter the bell just applied.
    if (keepOverdue) parts.push("overdue=1");
    return "/patients" + (parts.length ? "?" + parts.join("&") : "");
  }
%>
<div class="page-head" style="display:flex;align-items:center;justify-content:space-between">
  <div>
    <h1><%= t("pat.title") %></h1>
    <div class="sub"><%= t("pat.count", { n: patients.length }) %><%= q ? " " + t("pat.matching", { q }) : "" %></div>
  </div>
  <a class="btn" href="/patients/new"><%= t("pat.add") %></a>
</div>

<div class="card">
  <%# Live: results update as you type ("No need to click enter when
      searching for patients"). Still a real GET form underneath, so Enter,
      Back and a shared link all keep working. %>
  <form method="GET" action="/patients" class="list-controls" data-live-search>
    <div class="search-wrap search-wrap-lg">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-3.6-3.6"/></svg>
      <input class="search search-lg" type="search" name="q" value="<%= q %>"
             placeholder="<%= t('pat.search') %>" autofocus autocomplete="off" />
    </div>
    <% if (view !== "household") { %>
      <label class="field list-sort"><span><%= t("pat.sort_by") %></span>
        <select name="sort" onchange="this.form.submit()">
          <% Object.keys(sorts).forEach(k => { %>
            <option value="<%= k %>" <%= sort === k ? 'selected' : '' %>><%= sorts[k].label %></option>
          <% }) %>
        </select>
      </label>
    <% } else { %>
      <input type="hidden" name="view" value="household" />
    <% } %>
    <button class="btn" type="submit"><%= t("pat.search_btn") %></button>
  </form>

  <div data-live-results>
  <div class="view-tabs">
    <a class="view-tab <%= view === 'list' && !overdueOnly ? 'active' : '' %>" href="<%= viewLink('list') %>"><%= t("pat.tab_all") %></a>
    <a class="view-tab <%= view === 'household' && !overdueOnly ? 'active' : '' %>" href="<%= viewLink('household') %>"><%= t("pat.tab_household") %></a>
    <a class="view-tab" href="/families"><%= t("pat.tab_families") %></a>
    <%# Where the bell lands. Alyanna asked for the overdue on their own rather
        than having to pick the red badges out of the whole list. The count is
        on the tab so it agrees with the bell that sent you here. %>
    <% if (overdueTotal) { %>
      <a class="view-tab <%= overdueOnly ? 'active' : '' %>" href="<%= viewLink(view, true) %>">
        <%= t("pat.tab_overdue") %> <span class="badge bad" style="margin-left:5px"><%= overdueTotal %></span>
      </a>
    <% } %>
    <% if (view !== "household") { %>
      <div class="layout-toggle" role="group" aria-label="<%= t('pat.layout') %>">
        <a href="<%= layoutLink('list') %>" class="<%= listLayout === 'list' ? 'is-on' : '' %>" aria-current="<%= listLayout === 'list' ? 'true' : 'false' %>">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
          <span><%= t("pat.layout_list") %></span>
        </a>
        <a href="<%= layoutLink('cards') %>" class="<%= listLayout === 'cards' ? 'is-on' : '' %>" aria-current="<%= listLayout === 'cards' ? 'true' : 'false' %>">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
          <span><%= t("pat.layout_cards") %></span>
        </a>
      </div>
    <% } %>
  </div>

  <% if (overdueOnly && !patients.length) { %>
    <p class="muted" style="padding:8px 2px">
      <%= q ? t("pat.none_overdue_q") : t("pat.none_overdue") %>
      <a href="<%= viewLink(view) %>"><%= t("pat.show_all") %></a>
    </p>
  <% } else if (!patients.length) { %>
    <p class="muted" style="padding:8px 2px"><%- t("pat.none_yet") %></p>
  <% } else if (view === "household") { %>
    <%
      const { groups, loose } = household(patients);
    %>
    <% if (!groups.length) { %>
      <p class="muted" style="padding:8px 2px">
        No households grouped yet. Open a patient, press <b>Edit</b>, and search for a
        relative under <b>Family</b> — that puts them in the same household.
      </p>
    <% } %>
    <% groups.forEach(g => { %>
      <div class="household-group">
        <div class="household-head">
          <b><%= g.head.full_name %></b>
          <span class="muted">household · <%= g.members.length %> member<%= g.members.length === 1 ? "" : "s" %></span>
          <% if (g.members[0] && g.members[0].family_number) { %><a class="mini-btn" href="/families/<%= g.members[0].family_number %>" style="margin-left:auto">Family Record <%= g.members[0].family_number %> →</a><% } %>
        </div>
        <table class="tbl">
          <tbody>
            <% g.members.forEach(p => { %>
              <tr>
                <td class="mono" style="width:150px"><%= p.patient_number %></td>
                <td>
                  <a href="/patients/<%= p.patient_id %>"><%= p.full_name %></a>
                  <% if (p.is_minor) { %><span class="badge info" style="margin-left:6px"><%= t("pat.minor") %></span><% } %>
                  <% const od = overdue.get(p.patient_id); %><% if (od) { %><a href="/patients/<%= p.patient_id %>/immunization" class="badge bad" style="margin-left:6px;text-decoration:none" title="Oldest dose is <%= od.worstDays %> days late"><%= od.overdue %> overdue</a><% } %>
                </td>
                <td style="width:70px"><%= age(p.birthdate) %></td>
                <td><%= p.contact_number || "—" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% }) %>

    <% if (loose.length) { %>
      <div class="household-group">
        <div class="household-head">
          <b>Not in a household</b>
          <span class="muted"><%= loose.length %> patient<%= loose.length === 1 ? "" : "s" %></span>
        </div>
        <table class="tbl">
          <tbody>
            <% loose.forEach(p => { %>
              <tr>
                <td class="mono" style="width:150px"><%= p.patient_number %></td>
                <td>
                  <a href="/patients/<%= p.patient_id %>"><%= p.full_name %></a>
                  <% if (p.is_minor) { %><span class="badge info" style="margin-left:6px"><%= t("pat.minor") %></span><% } %>
                  <% const od = overdue.get(p.patient_id); %><% if (od) { %><a href="/patients/<%= p.patient_id %>/immunization" class="badge bad" style="margin-left:6px;text-decoration:none" title="Oldest dose is <%= od.worstDays %> days late"><%= od.overdue %> overdue</a><% } %>
                </td>
                <td style="width:70px"><%= age(p.birthdate) %></td>
                <td><%= p.contact_number || "—" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  <% } else if (listLayout === "cards") { %>
    <%# One card per patient, name first and large, every detail visible
        without scrolling sideways (Sept 29, for phones). The card is not itself
        a link: the overdue badge and the family number inside it are. %>
    <div class="patient-cards">
      <% patients.forEach(p => { %>
        <div class="patient-card">
          <a class="pc-name" href="/patients/<%= p.patient_id %>"><%= p.full_name %></a>
          <div class="pc-badges">
            <span class="mono muted"><%= p.patient_number %></span>
            <% if (p.is_minor) { %><span class="badge info"><%= t("pat.minor") %></span><% } %>
            <% if (p.deceased_at) { %><span class="badge bad"><%= t("pat.deceased") %></span><% } %>
            <% const od = overdue.get(p.patient_id); %><% if (od) { %><a href="/patients/<%= p.patient_id %>/immunization" class="badge bad" style="text-decoration:none"><%= od.overdue %> overdue</a><% } %>
          </div>
          <dl class="pc-meta">
            <div><dt><%= t("pat.col_age") %> · <%= t("pat.col_sex") %></dt><dd><%= age(p.birthdate) %> · <%= p.sex || "—" %></dd></div>
            <div><dt><%= t("pat.col_mobile") %></dt><dd class="mono"><%= p.contact_number || "—" %></dd></div>
            <div><dt><%= t("pat.col_email") %></dt><dd class="pc-email"><%= p.email || "—" %></dd></div>
            <div><dt><%= t("pat.col_family") %></dt><dd class="mono"><% if (p.family_number) { %><a href="/families/<%= p.family_number %>"><%= p.family_number %></a><% } else { %>—<% } %></dd></div>
          </dl>
          <div class="pc-actions">
            <a class="mini-btn" href="/patients/<%= p.patient_id %>"><%= t("pat.open") %></a>
            <a class="mini-btn" href="/patients/<%= p.patient_id %>/edit"><%= t("pat.edit") %></a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <table class="tbl">
      <thead>
        <tr><th><%= t("pat.col_num") %></th><th><%= t("pat.col_name") %></th><th><%= t("pat.col_sex") %></th><th><%= t("pat.col_age") %></th><th><%= t("pat.col_mobile") %></th><th><%= t("pat.col_email") %></th><th><%= t("pat.col_family") %></th><th></th></tr>
      </thead>
      <tbody>
        <% patients.forEach(p => { %>
          <tr>
            <td class="mono"><%= p.patient_number %></td>
            <td>
              <a href="/patients/<%= p.patient_id %>"><%= p.full_name %></a>
              <% if (p.is_minor) { %><span class="badge info" style="margin-left:6px"><%= t("pat.minor") %></span><% } %>
              <% if (p.deceased_at) { %><span class="badge bad" style="margin-left:6px"><%= t("pat.deceased") %></span><% } %>
              <% const od = overdue.get(p.patient_id); %><% if (od) { %><a href="/patients/<%= p.patient_id %>/immunization" class="badge bad" style="margin-left:6px;text-decoration:none" title="Oldest dose is <%= od.worstDays %> days late"><%= od.overdue %> overdue</a><% } %>
            </td>
            <td><%= p.sex || "—" %></td>
            <td><%= age(p.birthdate) %></td>
            <td class="mono"><%= p.contact_number || "—" %></td>
            <td><%= p.email || "—" %></td>
            <td class="mono"><% if (p.family_number) { %><a href="/families/<%= p.family_number %>"><%= p.family_number %></a><% } else { %>—<% } %></td>
            <td style="text-align:right"><a href="/patients/<%= p.patient_id %>/edit" class="muted"><%= t("pat.edit") %></a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
  </div>
</div>
