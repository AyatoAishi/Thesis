<%
  function age(bd) {
    if (!bd) return "—";
    const d = new Date(bd), n = new Date();
    let a = n.getFullYear() - d.getFullYear();
    const m = n.getMonth() - d.getMonth();
    if (m < 0 || (m === 0 && n.getDate() < d.getDate())) a--;
    return a;
  }
%>
<div class="page-head" style="display:flex;align-items:center;justify-content:space-between">
  <div>
    <h1>Patients</h1>
    <div class="sub"><%= patients.length %> record<%= patients.length === 1 ? "" : "s" %><%= q ? ` matching “${q}”` : "" %></div>
  </div>
  <a class="btn" href="/patients/new">+ Add patient</a>
</div>

<div class="card">
  <form method="GET" action="/patients" class="list-controls">
    <div class="search-wrap search-wrap-lg">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-3.6-3.6"/></svg>
      <input class="search search-lg" type="search" name="q" value="<%= q %>"
             placeholder="Search name, patient number, or contact…" autofocus />
    </div>
    <label class="field list-sort"><span>Sort by</span>
      <select name="sort" onchange="this.form.submit()">
        <% Object.keys(sorts).forEach(k => { %>
          <option value="<%= k %>" <%= sort === k ? 'selected' : '' %>><%= sorts[k].label %></option>
        <% }) %>
      </select>
    </label>
    <button class="btn" type="submit">Search</button>
  </form>

  <% if (!patients.length) { %>
    <p class="muted" style="padding:8px 2px">No patients yet. Click <b>Add patient</b> to create the first record.</p>
  <% } else { %>
    <table class="tbl">
      <thead>
        <tr><th>Patient #</th><th>Name</th><th>Sex</th><th>Age</th><th>Contact</th><th></th></tr>
      </thead>
      <tbody>
        <% patients.forEach(p => { %>
          <tr>
            <td class="mono"><%= p.patient_number %></td>
            <td>
              <a href="/patients/<%= p.patient_id %>"><%= p.full_name %></a>
              <% if (p.is_minor) { %><span class="badge info" style="margin-left:6px">Minor</span><% } %>
            </td>
            <td><%= p.sex || "—" %></td>
            <td><%= age(p.birthdate) %></td>
            <td><%= p.contact_number || "—" %></td>
            <td style="text-align:right"><a href="/patients/<%= p.patient_id %>/edit" class="muted">Edit</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
