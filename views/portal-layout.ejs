<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== "undefined" ? title : "Patient portal · Sampaguita HC" %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="portal-body">
  <header class="portal-top">
    <div class="brand">
      <span class="brand-badge"><%- include("partials/logo", { logoSize: 30 }) %></span>
      <div class="portal-brand-text">
        <b>Sampaguita Health Clinic</b>
        <span class="muted">Patient portal</span>
      </div>
    </div>
    <div class="portal-top-right">
      <%# "Add an 'About' button in the header in patient portal." %>
      <a class="portal-about-link" href="/portal/about">About</a>
      <% if (typeof me !== "undefined" && me) { %>
        <a class="portal-home-link" href="/portal">Home</a>
        <span class="portal-me"><%= me.full_name %></span>
        <form method="POST" action="/portal/logout" style="margin:0"><%- include("partials/csrf") %>
          <button type="submit" class="logout-btn">Log out</button>
        </form>
      <% } else { %>
        <a class="btn" href="/portal/login">Mag-sign in</a>
      <% } %>
    </div>
  </header>
  <main class="portal-main">
    <%- body %>
  </main>
  <footer class="portal-foot muted">
    Barangay Sampaguita Health Clinic · Your records are private (RA 10173)<br /><a class="legal-link" href="/privacy">Privacy Notice</a> &middot; <a class="legal-link" href="/terms">Terms of Service</a>
  </footer>
  <%# Ate Sam, portal side. Six answers of her own — the staff list would
      be worse than nothing here. See routes/portal.js. %>
  <%# Ate Sam's portal answers sit behind the patient sign-in, so she only
      appears for somebody signed in — on the public About page a bubble whose
      every question failed would be worse than no bubble. %>
  <% if (typeof me !== "undefined" && me) { %><%- include("partials/help", { helpBase: "/portal/help" }) %><% } %>
  <script src="/js/app.js"></script>
  <% if (typeof me !== "undefined" && me) { %><script src="/js/help.js"></script><% } %>
</body>
</html>
