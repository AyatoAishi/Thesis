<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== "undefined" ? title : "Patient portal · Sampaguita HC" %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="portal-body">
  <header class="portal-top">
    <div class="brand">
      <span class="brand-badge"><%- include("partials/logo", { logoSize: 30 }) %></span>
      <div class="portal-brand-text">
        <b>Sampaguita Health Clinic</b>
        <span class="muted">Patient portal</span>
      </div>
    </div>
    <div class="portal-top-right">
      <span class="portal-me"><%= me.full_name %></span>
      <form method="POST" action="/portal/logout" style="margin:0"><%- include("partials/csrf") %>
        <button type="submit" class="logout-btn">Log out</button>
      </form>
    </div>
  </header>
  <main class="portal-main">
    <%- body %>
  </main>
  <footer class="portal-foot muted">
    Barangay Sampaguita Health Clinic · Your records are private (RA 10173)<br /><a href="/privacy">Privacy Notice</a> &middot; <a href="/terms">Terms</a>
  </footer>
  <%# Ate Sam, portal side. Six answers of her own — the staff list would
      be worse than nothing here. See routes/portal.js. %>
  <%- include("partials/help", { helpBase: "/portal/help" }) %>
  <script src="/js/app.js"></script>
  <script src="/js/help.js"></script>
</body>
</html>
