<%
  // The immunization card, rendered identically for the signed-in patient and
  // for a minor dependent. Expects: immCategories, immOther, longDate. The
  // vaccine names and schedules come from lib/immunizationCard.js and stay as
  // printed on the DOH card, in both languages.
%>
<div class="card">
  <div class="panel-title" style="margin-bottom:4px"><%= t("por.imm_card") %></div>
  <p class="muted" style="font-size:13px;margin:0 0 12px">
    <%= t("por.imm_hint") %>
  </p>
  <% if (!immCategories.length && !immOther.length) { %>
    <p class="muted" style="margin:0"><%= t("por.imm_none") %></p>
  <% } else { %>
    <% immCategories.forEach(cat => { %>
      <div class="sub" style="margin:14px 0 6px;font-weight:700"><%= cat.label %></div>
      <table class="tbl">
        <thead><tr><th><%= t("por.imm_vaccine") %></th><th><%= t("por.imm_due") %></th><th><%= t("por.imm_doses") %></th></tr></thead>
        <tbody>
          <% cat.rows.forEach(v => { %>
            <tr>
              <td><%= v.name %></td>
              <td class="muted" style="font-size:12.5px"><%= v.schedule %></td>
              <td>
                <% v.doseSlots.forEach(s => { %>
                  <% if (s.given) { %>
                    <span class="badge ok" style="margin:0 4px 4px 0"><%= t("por.imm_dose", { n: s.doseNumber }) %> · <%= longDate(s.date) %></span>
                  <% } else { %>
                    <span class="badge" style="margin:0 4px 4px 0;background:var(--surface-2);color:var(--ink-3)"><%= t("por.imm_dose", { n: s.doseNumber }) %> · <%= t("por.imm_not_yet") %></span>
                  <% } %>
                <% }) %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% }) %>

    <% if (immOther.length) { %>
      <div class="sub" style="margin:14px 0 6px;font-weight:700"><%= t("por.imm_other") %></div>
      <table class="tbl">
        <thead><tr><th><%= t("por.imm_vaccine") %></th><th>Dose</th><th><%= t("por.imm_given") %></th></tr></thead>
        <tbody>
          <% immOther.forEach(r => { %>
            <tr>
              <td><%= r.vaccine_name %></td>
              <td class="mono"><%= r.dose_number %></td>
              <td><%= longDate(r.given_date) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  <% } %>
</div>
