<%# The About page the professors asked for, and the "how to make an
    appointment" instruction with it. Written for a patient, in both
    languages, and short — every paragraph answers one question somebody at the door would
    actually ask. Public, so it works before an account exists. %>
<div class="page-head about-head">
  <span class="about-seal"><%- include("../partials/logo", { logoSize: 72 }) %></span>
  <div>
    <h1>Sampaguita Health Clinic</h1>
    <div class="sub"><%= t("por.ab_station") %></div>
  </div>
</div>

<%- include("../partials/announcements") %>

<div class="portal-pair">
  <div class="card">
    <div class="panel-title" style="margin-bottom:10px"><%= t("por.ab_what") %></div>
    <ul class="about-list">
      <li><%- t("por.ab_what_1") %></li>
      <li><%- t("por.ab_what_2") %></li>
      <li><%- t("por.ab_what_3") %></li>
      <li><%- t("por.ab_what_4") %></li>
    </ul>
  </div>

  <div class="card about-book">
    <div class="panel-title" style="margin-bottom:10px"><%= t("por.how_book") %></div>
    <ol class="about-steps">
      <li><%- t("por.ab_step_1") %></li>
      <li><%- t("por.ab_step_2") %></li>
      <li><%- t("por.ab_step_3") %></li>
      <li><%- t("por.ab_step_4") %></li>
    </ol>
  </div>
</div>

<div class="portal-pair">
  <div class="card">
    <div class="panel-title" style="margin-bottom:10px"><%= t("por.ab_portal") %></div>
    <p style="margin:0 0 10px;line-height:1.6">
      <%- t("por.ab_portal_1") %>
    </p>
    <p class="muted" style="margin:0;font-size:13.5px;line-height:1.6">
      <%= t("por.ab_portal_2") %>
    </p>
  </div>

  <div class="card">
    <div class="panel-title" style="margin-bottom:10px"><%= t("por.ab_account") %></div>
    <p style="margin:0 0 10px;line-height:1.6">
      <%= t("por.ab_account_1") %>
    </p>
    <p class="muted" style="margin:0;font-size:13.5px;line-height:1.6">
      <%- t("por.ab_account_2") %>
    </p>
  </div>
</div>

<div class="card">
  <div class="panel-title" style="margin-bottom:8px"><%= t("por.ab_private") %></div>
  <p style="margin:0;line-height:1.6">
    <%- t("por.ab_private_1") %> <a class="legal-link" href="/privacy">Privacy Notice</a> <%= t("por.ab_and") %>
    <a class="legal-link" href="/terms">Terms of Service</a>.
  </p>
  <p class="muted" style="margin:10px 0 0;font-size:13.5px">
    <%- t("por.ab_emergency") %>
  </p>
</div>
