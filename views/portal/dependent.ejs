<%
  function statusBadge(s) {
    const m = { scheduled:["info",t("status.scheduled")], completed:["ok",t("status.completed")], missed:["bad",t("status.missed")], cancelled:["warn",t("status.cancelled")] };
    const [c, l] = m[s] || ["info", s];
    return `<span class="badge ${c}">${l}</span>`;
  }
  const firstName = child.full_name.split(" ")[0];
%>

<div class="page-head">
  <h1><%= child.full_name %></h1>
  <div class="sub mono"><%= child.patient_number %></div>
</div>

<p style="margin:-6px 0 18px"><a href="/portal"><%= t("por.back_me") %></a></p>

<div class="card portal-flash">
  <%- t("por.dep_why") %>
</div>

<div class="card">
  <div class="panel-title" style="margin-bottom:12px"><%= t("por.dep_appts", { name: firstName }) %></div>
  <% if (!appointments.length) { %>
    <p class="muted" style="margin:0"><%= t("por.dep_no_appts") %></p>
  <% } else { %>
    <table class="tbl">
      <thead><tr><th><%= t("por.col_date") %></th><th><%= t("por.col_service") %></th><th><%= t("por.col_time") %></th><th><%= t("por.col_status") %></th></tr></thead>
      <tbody>
        <% appointments.forEach(a => { %>
          <tr>
            <td><%= longDate(a.appointment_date) %></td>
            <td>
              <%= pretty(a.service_name) %>
              <% if (a.notes) { %>
                <div class="muted" style="font-size:12px;margin-top:2px"><%= a.notes %></div>
              <% } %>
            </td>
            <td class="mono"><%= shortTime(a.appointment_time) || "—" %></td>
            <td><%- statusBadge(a.status) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include("_immunization") %>

<div class="card">
  <div class="panel-title" style="margin-bottom:12px"><%= t("por.dep_meds", { name: firstName }) %></div>
  <% if (!medicines.length) { %>
    <p class="muted" style="margin:0"><%= t("por.dep_no_meds") %></p>
  <% } else { %>
    <table class="tbl">
      <thead><tr><th><%= t("por.col_date") %></th><th><%= t("por.col_medicine") %></th><th><%= t("por.col_qty") %></th></tr></thead>
      <tbody>
        <% medicines.forEach(m => { %>
          <tr>
            <td><%= longDate(m.date) %></td>
            <td><%= m.medicine_name %><%= m.dosage ? " " + m.dosage : "" %></td>
            <td class="mono"><%= m.quantity %> <%= m.unit || "" %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
