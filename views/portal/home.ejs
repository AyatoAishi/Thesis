<%
  function statusBadge(s) {
    const m = { scheduled:["info","Scheduled"], completed:["ok","Completed"], missed:["bad","Missed"], cancelled:["warn","Cancelled"] };
    const [c, l] = m[s] || ["info", s];
    return `<span class="badge ${c}">${l}</span>`;
  }
  const next = upcoming[0] || null;
%>

<div class="page-head">
  <h1>Hello, <%= me.full_name.split(" ")[0] %> 👋</h1>
  <div class="sub mono"><%= me.patient_number %></div>
</div>

<% if (flash.booked) { %>
  <div class="card portal-flash ok-flash">✅ Appointment booked! A confirmation email is on its way.</div>
<% } %>
<% if (flash.cancelled) { %>
  <div class="card portal-flash">Your appointment was cancelled.</div>
<% } %>
<% if (flash.err) { %>
  <div class="card portal-flash bad-flash">⚠️ <%= flash.err %></div>
<% } %>

<% if (!me.is_verified) { %>
  <div class="card portal-flash warn-flash">
    <b>Account pending verification.</b> Present your valid ID at the clinic and the staff
    will activate full access (medical records &amp; online booking). You can already see
    your appointments below.
  </div>
<% } %>

<div class="card hero-appt">
  <div class="panel-title" style="margin-bottom:6px">Next appointment</div>
  <% if (next) { %>
    <div class="hero-appt-main">
      <div class="hero-appt-date"><%= longDate(next.appointment_date) %></div>
      <div class="hero-appt-sub">
        <%= pretty(next.service_name) %><%= shortTime(next.appointment_time) ? " · " + shortTime(next.appointment_time) : "" %>
      </div>
    </div>
    <p class="muted" style="margin:8px 0 0;font-size:13px">We'll email you a reminder the day before. See you po!</p>
  <% } else { %>
    <p class="muted" style="margin:4px 0 0">No upcoming appointment<%= me.is_verified ? " — book one below" : "" %>.</p>
  <% } %>
</div>

<% if (me.is_verified) { %>
<div class="card">
  <div class="panel-title" style="margin-bottom:4px">Book an appointment</div>
  <p class="muted" style="margin:0 0 14px;font-size:13px">
    Pick a service and any available date.
  </p>
  <% if (!canBookMore) { %>
    <p class="muted" style="margin:0">You already have <%= maxOpen %> upcoming appointments — cancel one below to book another.</p>
  <% } else { %>
  <form method="POST" action="/portal/book" class="auth-form" style="gap:12px">
    <div class="form-grid">
      <label class="field">
        <span>Service</span>
        <select name="service_id" id="bk-service" required>
          <% bookOptions.forEach((s) => { %>
            <option value="<%= s.service_id %>"><%= pretty(s.name) %></option>
          <% }) %>
        </select>
      </label>
      <label class="field">
        <span>Date</span>
        <input type="date" name="appointment_date" id="bk-date" required
               min="<%= minBookDate %>" max="<%= maxBookDate %>" />
      </label>
      <label class="field" style="grid-column:1/-1">
        <span>Note for the clinic <span class="muted">(optional)</span></span>
        <input type="text" name="notes" maxlength="255" placeholder="e.g. follow-up, medsakit ang lalamunan…" />
      </label>
    </div>
    <button type="submit" class="btn" style="align-self:flex-start">Book appointment</button>
  </form>
  <% } %>
</div>
<% } %>

<div class="card">
  <div class="panel-title" style="margin-bottom:12px">My appointments</div>
  <% if (!appointments.length) { %>
    <p class="muted" style="margin:0">No appointments yet.</p>
  <% } else { %>
    <table class="tbl">
      <thead><tr><th>Date</th><th>Service</th><th>Time</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% appointments.forEach(a => { %>
          <tr>
            <td><%= longDate(a.appointment_date) %></td>
            <td><%= pretty(a.service_name) %></td>
            <td class="mono"><%= shortTime(a.appointment_time) || "—" %></td>
            <td><%- statusBadge(a.status) %></td>
            <td style="text-align:right">
              <% if (a.status === "scheduled" && a.appointment_date >= today) { %>
                <form method="POST" action="/portal/cancel/<%= a.appointment_id %>" style="margin:0"
                      onsubmit="return confirm('Cancel this appointment?')">
                  <button type="submit" class="mini-btn bad">Cancel</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<% if (me.is_verified) { %>

<% if (dependents.length) { %>
<div class="card">
  <div class="panel-title" style="margin-bottom:4px">👨‍👩‍👧 My household</div>
  <p class="muted" style="font-size:12.5px;margin:0 0 12px">
    Ang mga batang kasama mo sa household number na binigay ng clinic. Tingnan ang immunization
    card nila — ito ang hinihingi ng eskwelahan pag nag-eenroll.
  </p>
  <div class="dependent-list">
    <% dependents.forEach(d => { %>
      <a class="dependent-row" href="/portal/household/<%= d.patient_id %>">
        <span>
          <b><%= d.full_name %></b>
          <span class="muted mono" style="font-size:12px"><%= d.patient_number %></span>
        </span>
        <span class="muted">Tingnan ang records →</span>
      </a>
    <% }) %>
  </div>
</div>
<% } %>

<div class="card">
  <div class="panel-title" style="margin-bottom:12px">💊 Medicines I received</div>
  <% if (!medicines.length) { %>
    <p class="muted" style="margin:0">Nothing yet — medicines handed to you at the clinic will show up here.</p>
  <% } else { %>
    <table class="tbl">
      <thead><tr><th>Date</th><th>Medicine</th><th>Quantity</th></tr></thead>
      <tbody>
        <% medicines.forEach(m => { %>
          <tr>
            <td><%= longDate(m.date) %></td>
            <td><%= m.medicine_name %><%= m.dosage ? " " + m.dosage : "" %></td>
            <td class="mono"><%= m.quantity %> <%= m.unit || "" %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include("_immunization", { who: "My" }) %>

<% if (prenatal) { %>
<%
  const ttDoses = [prenatal.tt1_date, prenatal.tt2_date, prenatal.tt3_date, prenatal.tt4_date, prenatal.tt5_date];
  const ttGiven = ttDoses.filter(Boolean).length;
%>
<div class="card">
  <div class="panel-title" style="margin-bottom:12px">🤰 My pre-natal record</div>

  <% if (prenatal.edd && prenatal.status === "active") { %>
    <div class="hero-appt-main" style="margin-bottom:14px">
      <div class="hero-appt-date"><%= longDate(prenatal.edd) %></div>
      <div class="hero-appt-sub">Expected delivery date</div>
    </div>
  <% } %>

  <dl class="kv">
    <div><dt>Status</dt><dd>
      <% if (prenatal.status === "active") { %><span class="badge info">Ongoing</span>
      <% } else if (prenatal.status === "delivered") { %><span class="badge ok">Delivered</span>
      <% } else { %><span class="badge">Closed</span><% } %>
    </dd></div>
    <div><dt>Last menstrual period</dt><dd><%= prenatal.lmp ? longDate(prenatal.lmp) : "—" %></dd></div>
    <div><dt>Pregnancies (G / P)</dt><dd class="mono"><%= prenatal.gravida ?? "—" %> / <%= prenatal.para ?? "—" %></dd></div>
    <div><dt>Tetanus doses</dt><dd><%= ttGiven %> of 5 recorded</dd></div>
  </dl>

  <div class="panel-title" style="margin:18px 0 10px;font-size:14px">Check-ups</div>
  <% if (!prenatalVisits.length) { %>
    <p class="muted" style="margin:0">No check-ups recorded yet.</p>
  <% } else { %>
    <table class="tbl">
      <thead><tr><th>Date</th><th>Weeks (AOG)</th><th>Blood pressure</th><th>Weight</th><th>Baby's heartbeat</th></tr></thead>
      <tbody>
        <% prenatalVisits.forEach(v => { %>
          <tr>
            <td><%= longDate(v.visit_date) %></td>
            <td><%= v.aog || "—" %></td>
            <td class="mono"><%= v.bp || "—" %></td>
            <td class="mono"><%= v.weight_kg ? v.weight_kg + " kg" : "—" %></td>
            <td class="mono"><%= v.fetal_heart_tone || "—" %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
<% } %>

<% if (visits.length) { %>
<div class="card">
  <div class="panel-title" style="margin-bottom:12px">My visit records</div>
  <table class="tbl">
    <thead><tr><th>Date</th><th>Blood pressure</th><th>Weight</th><th>Temp</th><th>Diagnosis</th></tr></thead>
    <tbody>
      <% visits.forEach(v => { %>
        <tr>
          <td><%= longDate(v.visit_date) %></td>
          <td class="mono"><%= v.bp_systolic && v.bp_diastolic ? `${v.bp_systolic}/${v.bp_diastolic}` : "—" %></td>
          <td class="mono"><%= v.weight_kg ? v.weight_kg + " kg" : "—" %></td>
          <td class="mono"><%= v.temperature_c ? v.temperature_c + " °C" : "—" %></td>
          <td><%= v.diagnosis || "—" %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<% } %>

<div class="card">
  <div class="panel-title" style="margin-bottom:12px">My information</div>
  <dl class="kv">
    <div><dt>Full name</dt><dd><%= me.full_name %></dd></div>
    <div><dt>Patient number</dt><dd class="mono"><%= me.patient_number %></dd></div>
    <div><dt>Birthdate</dt><dd><%= me.birthdate ? longDate(me.birthdate) : "—" %></dd></div>
    <div><dt>Sex</dt><dd><%= me.sex || "—" %></dd></div>
    <div><dt>Contact number</dt><dd><%= me.contact_number || "—" %></dd></div>
    <div><dt>Email</dt><dd><%= me.email || "—" %></dd></div>
    <div style="grid-column:1/-1"><dt>Address</dt><dd><%= me.address || "—" %></dd></div>
  </dl>
  <p class="muted" style="font-size:12px;margin:12px 2px 0">
    Something wrong? Tell the staff on your next visit — only the clinic can edit records.
  </p>
</div>

<div class="card">
  <div class="panel-title" style="margin-bottom:4px">🔑 Change my password</div>
  <p class="muted" style="font-size:12.5px;margin:0 0 14px">
    Palitan ang password na binigay sa iyo ng clinic. Kung nakalimutan mo ang password mo,
    <a href="/portal/recover">gamitin ang recovery code</a> mo sa sign-in page.
  </p>

  <% if (flash.pwOk) { %>
    <div class="auth-notice" style="margin-bottom:14px">✅ Napalitan na ang password mo.</div>
  <% } %>
  <% if (flash.pwErr) { %>
    <div class="auth-error" style="margin-bottom:14px"><%= flash.pwErr %></div>
  <% } %>

  <form method="POST" action="/portal/password" class="auth-form" style="gap:12px" autocomplete="off">
    <div class="form-grid">
      <label class="field" style="grid-column:1/-1">
        <span>Current password</span>
        <input type="password" name="current_password" required />
      </label>
      <label class="field">
        <span>New password</span>
        <input type="password" name="password" minlength="8" required />
      </label>
      <label class="field">
        <span>Type it again</span>
        <input type="password" name="password2" minlength="8" required />
      </label>
    </div>
    <p class="muted" style="margin:0;font-size:12px">Kahit anong 8 characters pataas.</p>
    <button type="submit" class="btn" style="align-self:flex-start">Change password</button>
  </form>
</div>
