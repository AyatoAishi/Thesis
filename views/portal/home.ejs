<%
  // 2026-09-25, from the professors' review of the patient side:
  //   - "Dapat magkatabi na yung my appointments sabay next appointments … yung
  //     medicines at card magkatabi naman." The page is now two pairs of boxes
  //     side by side on a computer, stacked on a phone.
  //   - "Yung color ng box ng appointments is something na makakuha ng
  //     atensyon" — the next appointment is a solid green panel, the one
  //     coloured block on the page.
  //   - "Yung ibang text mejo crowded pa … mapa igsi" — every sentence here
  //     was cut to the one thing it has to say, in one language.
  function statusBadge(s) {
    const m = { scheduled:["info","Naka-schedule"], completed:["ok","Tapos na"], missed:["bad","Hindi nakapunta"], cancelled:["warn","Kinansela"] };
    const [c, l] = m[s] || ["info", s];
    return `<span class="badge ${c}">${l}</span>`;
  }
  const next = upcoming[0] || null;
  // The tables sit in half-width boxes now, where "Thursday, July 9, 2026"
  // pushed the status column off the edge. The weekday stays on the big
  // next-appointment date, where it is the point; the tables get "Jul 9, 2026".
  function shortD(d) {
    if (!d) return "—";
    const iso = d instanceof Date ? d.toLocaleDateString("en-CA", { timeZone: "Asia/Manila" }) : String(d).slice(0, 10);
    return new Date(iso + "T00:00:00+08:00").toLocaleDateString("en-PH", { timeZone: "Asia/Manila", month: "short", day: "numeric", year: "numeric" });
  }
  const onTempPassword = !me.password_changed_at;
%>

<div class="page-head">
  <h1>Hello, <%= me.full_name.split(" ")[0] %> 👋</h1>
  <div class="sub mono"><%= me.patient_number %></div>
</div>

<% if (flash.err) { %>
  <div class="card portal-flash bad-flash">⚠️ <%= flash.err %></div>
<% } %>

<%# "Add a note on patient portal, that can change their password after
    creating an account." Shown at the top while the clinic's temporary
    password is still the one in use, and gone once they have set their own. %>
<% if (onTempPassword) { %>
  <a class="card portal-flash warn-flash portal-temp-pw" href="#change-password">
    <b>Pansamantala pa ang password mo.</b> Palitan ito ng sarili mo — nasa ibaba ng page. →
  </a>
<% } %>

<% if (!me.is_verified) { %>
  <div class="card portal-flash warn-flash">
    <b>Hindi pa verified ang account mo.</b> Ipakita ang valid ID sa clinic para makita ang buong record mo.
  </div>
<% } %>

<div class="portal-pair">
  <div class="card hero-appt<%= next ? "" : " is-empty" %>">
    <div class="panel-title" style="margin-bottom:8px">Susunod na appointment</div>
    <% if (next) { %>
      <div class="hero-appt-main">
        <div class="hero-appt-date"><%= longDate(next.appointment_date) %></div>
        <div class="hero-appt-sub">
          <%= pretty(next.service_name) %><%= shortTime(next.appointment_time) ? " · " + shortTime(next.appointment_time) : "" %>
        </div>
        <% if (next.notes) { %><div class="hero-appt-note"><%= next.notes %></div><% } %>
      </div>
      <p class="hero-appt-foot">Paaalalahanan ka namin isang araw bago.</p>
    <% } else { %>
      <p class="muted" style="margin:4px 0 0">Wala kang naka-schedule.</p>
    <% } %>
    <%# "Add an instruction on how to do an appointment." Walk-in only — the
        portal does not book, on purpose (one calendar, one set of hands). %>
    <div class="how-to-book">
      <b>Paano magpa-appointment?</b>
      Pumunta sa clinic, <b>8 AM – 5 PM</b> (sarado 12–1), dala ang patient number mo.
      Ang staff ang maglalagay ng schedule.
    </div>
  </div>

  <div class="card">
    <div class="panel-title" style="margin-bottom:12px">Mga appointment ko</div>
    <% if (!appointments.length) { %>
      <p class="muted" style="margin:0">Wala pa.</p>
    <% } else { %>
      <div class="scroll-box" style="max-height:300px">
        <table class="tbl">
          <thead><tr><th>Petsa</th><th>Serbisyo</th><th>Oras</th><th>Status</th></tr></thead>
          <tbody>
            <% appointments.forEach(a => { %>
              <tr>
                <td style="white-space:nowrap"><%= shortD(a.appointment_date) %></td>
                <td>
                  <%= pretty(a.service_name) %>
                  <%# For an "Other" visit the note IS the record. %>
                  <% if (a.notes) { %><div class="muted" style="font-size:12.5px;margin-top:2px"><%= a.notes %></div><% } %>
                </td>
                <td class="mono"><%= shortTime(a.appointment_time) || "—" %></td>
                <td><%- statusBadge(a.status) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
    <p class="muted" style="font-size:13px;margin:12px 2px 0">Para magpalit o magkansela, sabihin sa clinic.</p>
  </div>
</div>

<% if (me.is_verified) { %>

<div class="portal-pair">
  <div class="card">
    <div class="panel-title" style="margin-bottom:12px">💊 Mga gamot na natanggap ko</div>
    <% if (!medicines.length) { %>
      <p class="muted" style="margin:0">Wala pa.</p>
    <% } else { %>
      <div class="scroll-box" style="max-height:320px">
        <table class="tbl">
          <thead><tr><th>Petsa</th><th>Gamot</th><th>Dami</th></tr></thead>
          <tbody>
            <% medicines.forEach(m => { %>
              <tr>
                <td style="white-space:nowrap"><%= shortD(m.date) %></td>
                <td>
                  <%= m.medicine_name %><%= m.dosage ? " " + m.dosage : "" %>
                  <%# How often to take it, written by the nurse at the desk. %>
                  <% if (m.instructions) { %><div class="med-how">🕑 <%= m.instructions %></div><% } %>
                </td>
                <td class="mono" style="white-space:nowrap"><%= m.quantity %> <%= m.unit || "" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="portal-pair-cell">
    <%- include("_immunization", { who: "My" }) %>
  </div>
</div>

<% if (dependents.length) { %>
<div class="card">
  <div class="panel-title" style="margin-bottom:4px">👨‍👩‍👧 Mga anak ko</div>
  <p class="muted" style="font-size:13px;margin:0 0 12px">Buksan para makita ang immunization card nila.</p>
  <div class="dependent-list">
    <% dependents.forEach(d => { %>
      <a class="dependent-row" href="/portal/household/<%= d.patient_id %>">
        <span>
          <b><%= d.full_name %></b>
          <span class="muted mono" style="font-size:12.5px"><%= d.patient_number %></span>
        </span>
        <span class="muted">Tingnan →</span>
      </a>
    <% }) %>
  </div>
</div>
<% } %>

<% if (prenatal) { %>
<%
  const ttDoses = [prenatal.tt1_date, prenatal.tt2_date, prenatal.tt3_date, prenatal.tt4_date, prenatal.tt5_date];
  const ttGiven = ttDoses.filter(Boolean).length;
%>
<div class="card">
  <div class="panel-title" style="margin-bottom:12px">🤰 Prenatal record ko</div>

  <% if (prenatal.edd && prenatal.status === "active") { %>
    <div class="hero-appt-main" style="margin-bottom:14px">
      <div class="hero-appt-date" style="color:var(--accent-strong)"><%= longDate(prenatal.edd) %></div>
      <div class="hero-appt-sub">Inaasahang petsa ng panganganak</div>
    </div>
  <% } %>

  <dl class="kv">
    <div><dt>Status</dt><dd>
      <% if (prenatal.status === "active") { %><span class="badge info">Tuloy-tuloy</span>
      <% } else if (prenatal.status === "delivered") { %><span class="badge ok">Nanganak na</span>
      <% } else { %><span class="badge">Sarado</span><% } %>
    </dd></div>
    <div><dt>Huling regla (LMP)</dt><dd><%= prenatal.lmp ? longDate(prenatal.lmp) : "—" %></dd></div>
    <div><dt>Pagbubuntis (G / P)</dt><dd class="mono"><%= prenatal.gravida ?? "—" %> / <%= prenatal.para ?? "—" %></dd></div>
    <div><dt>Tetanus</dt><dd><%= ttGiven %> sa 5 na dose</dd></div>
  </dl>

  <div class="panel-title" style="margin:18px 0 10px;font-size:15px">Mga check-up</div>
  <% if (!prenatalVisits.length) { %>
    <p class="muted" style="margin:0">Wala pa.</p>
  <% } else { %>
    <div style="overflow-x:auto">
      <table class="tbl">
        <thead><tr><th>Petsa</th><th>Linggo (AOG)</th><th>BP</th><th>Timbang</th><th>Tibok ng puso ng baby</th></tr></thead>
        <tbody>
          <% prenatalVisits.forEach(v => { %>
            <tr>
              <td><%= longDate(v.visit_date) %></td>
              <td><%= v.aog || "—" %></td>
              <td class="mono"><%= v.bp || "—" %></td>
              <td class="mono"><%= v.weight_kg ? v.weight_kg + " kg" : "—" %></td>
              <td class="mono"><%= v.fetal_heart_tone || "—" %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<% } %>

<% if (visits.length) { %>
<div class="card">
  <div class="panel-title" style="margin-bottom:12px">Mga konsultasyon ko</div>
  <div style="overflow-x:auto">
    <table class="tbl">
      <thead><tr><th>Petsa</th><th>BP</th><th>Timbang</th><th>Temp</th><th>Diagnosis</th></tr></thead>
      <tbody>
        <% visits.forEach(v => { %>
          <tr>
            <td><%= longDate(v.visit_date) %></td>
            <td class="mono"><%= v.bp_systolic && v.bp_diastolic ? `${v.bp_systolic}/${v.bp_diastolic}` : "—" %></td>
            <%# NUMERIC arrives padded to its scale ("58.50") — trim it. %>
            <td class="mono"><%= v.weight_kg ? Number(v.weight_kg) + " kg" : "—" %></td>
            <td class="mono"><%= v.temperature_c ? Number(v.temperature_c) + " °C" : "—" %></td>
            <td><%= v.diagnosis || "—" %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<% } %>

<div class="portal-pair">
  <div class="card">
    <div class="panel-title" style="margin-bottom:12px">Impormasyon ko</div>
    <dl class="kv">
      <div><dt>Pangalan</dt><dd><%= me.full_name %></dd></div>
      <div><dt>Patient number</dt><dd class="mono"><%= me.patient_number %></dd></div>
      <div><dt>Kaarawan</dt><dd><%= me.birthdate ? longDate(me.birthdate) : "—" %></dd></div>
      <div><dt>Kasarian</dt><dd><%= me.sex === "male" ? "Lalaki" : me.sex === "female" ? "Babae" : "—" %></dd></div>
      <div><dt>Numero</dt><dd class="mono"><%= me.contact_number || "—" %></dd></div>
      <div><dt>Email</dt><dd><%= me.email || "—" %></dd></div>
      <div style="grid-column:1/-1"><dt>Address</dt><dd><%= me.address || "—" %></dd></div>
    </dl>
    <p class="muted" style="font-size:13px;margin:12px 2px 0">May mali? Sabihin sa clinic — sila lang ang makakapag-ayos.</p>
  </div>

  <div class="card" id="change-password">
    <div class="panel-title" style="margin-bottom:4px">🔑 Palitan ang password</div>
    <%# The professors gave the exact wording, and it is shorter and clearer
        than what was here. %>
    <p class="muted" style="font-size:13px;margin:0 0 14px">
      Kung makalimutan, agad na pumunta sa klinika dala ang valid ID upang mabigyan ng bagong password.
    </p>

    <% if (flash.pwOk) { %>
      <div class="auth-notice" style="margin-bottom:14px">✅ Napalitan na ang password mo.</div>
    <% } %>
    <% if (flash.pwErr) { %>
      <div class="auth-error" style="margin-bottom:14px"><%= flash.pwErr %></div>
    <% } %>

    <form method="POST" action="/portal/password" class="auth-form" style="gap:12px"><%- include("../partials/csrf") %>
      <label class="field">
        <span>Kasalukuyang password</span>
        <%- include("../partials/password-field", { name: "current_password", autocomplete: "current-password" }) %>
      </label>
      <label class="field">
        <span>Bagong password <span class="muted">(8 characters pataas)</span></span>
        <%- include("../partials/password-field", { name: "password", minlength: 8, autocomplete: "new-password" }) %>
      </label>
      <label class="field">
        <span>Ulitin ang bagong password</span>
        <%- include("../partials/password-field", { name: "password2", minlength: 8, autocomplete: "new-password" }) %>
      </label>
      <button type="submit" class="btn" style="align-self:flex-start">Palitan</button>
    </form>
  </div>
</div>
