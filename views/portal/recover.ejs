<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="auth-body">
  <main class="auth-wrap">
    <div class="auth-card">
      <div class="auth-brand">
        <span class="brand-badge">S</span>
        <div>
          <b>Sampaguita Health Clinic</b>
          <span class="muted">Patient portal</span>
        </div>
      </div>

      <h1 class="auth-title">Nakalimutan ang password?</h1>

      <% if (mode === "sent") { %>
        <div class="auth-notice">
          Kung may account na naka-ugnay sa email na iyon, may ipinadala kaming link doon.
          Pindutin po ito sa loob ng <b>isang oras</b> para makapaglagay ng bagong password.
        </div>
        <div class="recover-steps" style="margin-top:16px">
          <p class="muted" style="margin:0;font-size:13px">
            Tingnan din po ang <b>Spam</b> o <b>Promotions</b> folder. Kung wala pa ring dumating
            pagkalipas ng ilang minuto, ibig sabihin ay walang email na nakatala sa account mo —
            pumunta na lang po sa clinic dala ang valid ID at bibigyan ka ng staff ng bagong
            pansamantalang password.
          </p>
        </div>

      <% } else if (mode === "unavailable") { %>
        <div class="auth-notice warn">
          Hindi po muna kayang magpadala ng email ng sistema ngayon, kaya walang link na
          maipapadala.
        </div>
        <div class="recover-steps">
          <p style="margin:0 0 14px;font-size:14px">Ganito po ang gawin:</p>
          <ol>
            <li>Pumunta sa <b>Barangay Sampaguita Health Clinic</b>.</li>
            <li>Dalhin ang <b>valid ID</b> na ginamit noong ginawa ang account mo.</li>
            <li>Sabihin sa staff na nakalimutan mo ang password mo sa portal.</li>
            <li>Bibigyan ka nila ng <b>bagong pansamantalang password</b> — pwede mo itong
                palitan pagkapasok mo.</li>
          </ol>
        </div>

      <% } else { %>
        <p style="margin:0 0 16px;font-size:14px;line-height:1.6">
          Ilagay po ang email address na ibinigay ninyo sa clinic. Ipapadala namin doon ang link
          para makapaglagay kayo ng bagong password.
        </p>

        <% if (error) { %>
          <div class="auth-error"><%= error %></div>
        <% } %>

        <form method="POST" action="/portal/recover" class="auth-form">
          <label class="field">
            <span>Email address</span>
            <input type="email" name="email" value="<%= emailValue %>" required autofocus
                   autocomplete="email" autocapitalize="none" spellcheck="false"
                   placeholder="pangalan@gmail.com" />
          </label>
          <button type="submit" class="btn auth-submit">Ipadala ang link</button>
        </form>

        <div class="recover-steps" style="margin-top:18px">
          <p class="muted" style="margin:0;font-size:12.5px;line-height:1.6">
            <b>Walang email na naibigay sa clinic?</b> Pumunta po sa clinic dala ang valid ID na
            ginamit noong ginawa ang account ninyo, at bibigyan kayo ng staff ng bagong
            pansamantalang password.
          </p>
        </div>
      <% } %>

      <div class="auth-links" style="margin-top:18px">
        <a href="/portal/login">← Balik sa sign in</a>
      </div>

      <p class="auth-foot muted">Your health records are private · RA 10173 protected</p>
    </div>
  </main>
</body>
</html>
