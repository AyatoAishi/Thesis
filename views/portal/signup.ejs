<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="auth-body">
  <main class="auth-wrap">
    <div class="auth-card auth-card-wide">
      <div class="auth-brand">
        <span class="brand-badge">S</span>
        <div>
          <b>Sampaguita Health Clinic</b>
          <span class="muted">Patient portal</span>
        </div>
      </div>

      <% if (success) { %>
        <h1 class="auth-title">Account created 🎉</h1>
        <div class="auth-notice" style="margin-bottom:14px">
          Save these now — the recovery code is shown <b>only once</b>.
        </div>
        <dl class="kv" style="grid-template-columns:1fr">
          <div><dt>Username</dt><dd class="mono"><%= success.username %></dd></div>
          <div><dt>Recovery code <span class="muted">(for “Forgot password”)</span></dt>
            <dd class="mono" style="font-size:20px;font-weight:700"><%= success.recoveryCode %></dd></div>
        </dl>
        <div class="auth-notice" style="margin-top:14px">
          Your account is <b>pending verification</b> — on your next clinic visit, present the
          valid ID you entered and the staff will activate your full access. You can already
          sign in and see your appointments.
        </div>
        <a class="btn auth-submit" style="margin-top:16px;text-align:center" href="/portal/login">Go to sign in</a>
      <% } else { %>
        <h1 class="auth-title">Create your portal account</h1>
        <p class="muted" style="margin:-8px 0 16px;font-size:13px">
          Enter your details <b>exactly as recorded at the clinic</b>. Bring the valid ID you
          choose below on your next visit so the staff can verify your account.
        </p>

        <% if (errors && errors.length) { %>
          <div class="auth-error">
            <% errors.forEach(e => { %><div><%= e %></div><% }) %>
          </div>
        <% } %>

        <form method="POST" action="/portal/signup" class="auth-form" autocomplete="off">
          <div class="form-grid">
            <label class="field">
              <span>Patient number</span>
              <input type="text" name="patient_number" value="<%= form.patient_number || '' %>"
                     placeholder="SAMP-2026-0001" required autocapitalize="characters" spellcheck="false" />
            </label>
            <label class="field">
              <span>Birthdate</span>
              <input type="date" name="birthdate" value="<%= form.birthdate || '' %>" required />
            </label>
            <label class="field" style="grid-column:1/-1">
              <span>Full name (as written at the clinic)</span>
              <input type="text" name="full_name" value="<%= form.full_name || '' %>" required />
            </label>
            <label class="field">
              <span>Valid ID you will present</span>
              <select name="valid_id_type" required>
                <option value="">— choose an ID —</option>
                <% idTypes.forEach(t => { %>
                  <option value="<%= t %>" <%= form.valid_id_type === t ? 'selected' : '' %>><%= t %></option>
                <% }) %>
              </select>
            </label>
            <label class="field">
              <span>Valid ID number</span>
              <input type="text" name="valid_id_number" value="<%= form.valid_id_number || '' %>" required />
            </label>
            <label class="field">
              <span>Choose a username</span>
              <input type="text" name="username" value="<%= form.username || '' %>"
                     placeholder="e.g. juan.dela.cruz" required autocapitalize="none" spellcheck="false" />
            </label>
            <label class="field">
              <span>Choose a password <span class="muted">(8+ characters)</span></span>
              <input type="password" name="password" minlength="8" required />
            </label>
          </div>
          <button type="submit" class="btn auth-submit">Create account</button>
        </form>

        <div class="auth-links">
          <a href="/portal/login">← Back to sign in</a>
        </div>
      <% } %>

      <p class="auth-foot muted">Your health records are private · RA 10173 protected</p>
    </div>
  </main>
</body>
</html>
