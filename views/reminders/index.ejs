<div class="page-head">
  <h1>Reminders</h1>
  <div class="sub">Email &amp; SMS appointment reminders &amp; delivery log</div>
</div>

<% if (flash) { %>
  <div class="card" style="background:var(--accent-softer);border-color:var(--accent-soft)"><%= flash %></div>
<% } %>

<% if (failures && failures.n > 0) { %>
  <div class="page-alert bad">
    <span>
      <b><%= failures.n %> reminder<%= failures.n === 1 ? "" : "s" %> failed to send in the last 30 days.</b>
      Those patients were never told about their appointment. Press <b>Test email now</b> below to find out why.
    </span>
  </div>
<% } %>

<div class="card">
  <div class="svc-head">
    <div>
      <span class="panel-title">Email</span>
      <% if (emailInfo.mode === "api") { %>
        <span class="badge ok">LIVE — Brevo API</span>
      <% } else if (emailInfo.mode === "smtp") { %>
        <span class="badge ok">LIVE — SMTP (<%= emailInfo.smtp_host %>)</span>
      <% } else { %>
        <span class="badge warn">SIMULATION — no mail credentials</span>
      <% } %>
    </div>
    <form method="POST" action="/reminders/test-email" style="margin:0"><%- include("../partials/csrf") %>
      <button class="logout-btn" type="submit" style="cursor:pointer">Test email now</button>
    </form>
  </div>
  <p class="muted" style="margin:8px 2px 0;font-size:13px">
    Reminders are emailed to the patient (or the family contact as fallback) the day before the
    appointment. A confirmation also goes out the moment an appointment is booked.
  </p>

  <% if (emailTest) { %>
    <div class="mail-test">
      <div class="page-alert <%= emailTest.ok ? "ok" : "bad" %>" style="margin:0">
        <span>
          <b><%= emailTest.ok ? "Email is working." : "Email cannot go out from this server." %></b>
          <%= emailTest.detail %>
        </span>
      </div>
      <dl class="mail-facts">
        <dt>Sending by</dt>
        <dd><%= emailTest.mode === "api" ? "Brevo HTTP API" : emailTest.mode === "smtp" ? "SMTP" : "nothing (simulation)" %></dd>
        <% if (emailTest.mode === "smtp") { %>
          <dt>Server</dt><dd><%= emailTest.smtp_host %>:<%= emailTest.smtp_port %></dd>
          <dt>Username</dt><dd><%= emailTest.smtp_user_set ? "set" : "MISSING" %></dd>
          <dt>Password</dt><dd><%= emailTest.smtp_pass_set ? "set" : "MISSING" %></dd>
        <% } %>
        <% if (emailTest.mode === "api") { %>
          <dt>API key</dt><dd><%= emailTest.api_key_set ? "set" : "MISSING" %></dd>
        <% } %>
        <dt>From</dt><dd><%= emailTest.from_email %></dd>
        <dt>Took</dt><dd><%= emailTest.ms %> ms</dd>
      </dl>
      <% if (!emailTest.ok && emailTest.mode === "smtp") { %>
        <p class="detail muted">
          If this says the connection timed out, the credentials are fine — this host is blocking
          outgoing mail, which free hosting commonly does. Set <code class="mono">BREVO_API_KEY</code>
          in the hosting dashboard to send over the web instead; nothing else needs to change.
        </p>
      <% } %>
    </div>
  <% } %>

  <div class="svc-head" style="margin-top:16px;opacity:.6"
       title="No SMS provider is connected yet — PhilSMS is being looked at.">
    <div>
      <span class="panel-title">SMS</span>
      <% if (live) { %>
        <span class="badge ok">LIVE — <%= smsProvider %></span>
      <% } else { %>
        <span class="badge info">NO PROVIDER — simulation only</span>
      <% } %>
    </div>
    <% if (live && balance !== null) { %>
      <span class="muted">Credit balance: <b><%= balance %></b></span>
    <% } %>
  </div>
  <% if (!live) { %>
    <p class="muted" style="margin:8px 2px 0;font-size:13px;opacity:.75">
      No text message has actually been sent. SMS rows in the log below are a dry run — the message
      was composed and recorded, but nothing left the building. Add
      <code class="mono">PHILSMS_TOKEN</code> and <code class="mono">PHILSMS_SENDER</code> to go
      live; no other change is needed.
    </p>
  <% } %>
</div>

<div class="card">
  <div class="panel-title" style="margin-bottom:12px">Send reminders</div>
  <form method="POST" action="/reminders/run-now" class="daynav-left" style="gap:12px;flex-wrap:wrap;align-items:flex-end"><%- include("../partials/csrf") %>
    <label class="field" style="gap:4px">
      <span>For appointments on</span>
      <input type="date" name="date" value="<%= date %>" />
    </label>
    <label class="field" style="gap:4px">
      <span>Send by</span>
      <select name="only">
        <option value="">Each patient's own setting</option>
        <option value="email">Email only</option>
        <option value="sms">SMS only</option>
      </select>
    </label>
    <label class="check" style="align-items:center">
      <input type="checkbox" name="force" /> <span>Resend even if already reminded</span>
    </label>
    <button class="btn" type="submit">Send now (<%= pending %> scheduled)</button>
  </form>
  <p class="muted" style="font-size:12px;margin:10px 2px 0">
    Runs automatically every day at the schedule <code class="mono"><%= cronExpr %></code> (Asia/Manila).
    Each patient's record says how they want to be reminded — <b>Send by</b> narrows this one run further.
    A patient with no address on a channel is skipped, not marked failed.
  </p>
</div>

<div class="card">
  <div class="panel-title" style="margin-bottom:12px">Recent reminders <span class="muted">(last 100)</span></div>
  <% if (!log.length) { %>
    <p class="muted" style="margin:0">No reminders sent yet. Book an appointment, then run a send above.</p>
  <% } else { %>
    <table class="tbl">
      <thead><tr><th>When</th><th>Patient</th><th>Channel</th><th>To</th><th>Type</th><th>Status</th></tr></thead>
      <tbody>
        <% log.forEach(n => { %>
          <tr>
            <td class="mono" style="font-size:12px"><%= new Date(n.created_at).toLocaleString("en-PH", { timeZone:"Asia/Manila", month:"short", day:"numeric", hour:"numeric", minute:"2-digit" }) %></td>
            <td><a href="/patients/<%= n.patient_id %>" title="<%= n.message %>"><%= n.full_name %></a></td>
            <td><span class="badge <%= n.channel === 'email' ? 'ok' : 'info' %>"><%= n.channel %></span></td>
            <td class="mono" style="font-size:12px"><%= n.recipient %></td>
            <td><%= n.recipient_type %></td>
            <td>
              <% if (n.status === 'sent') { %><span class="badge ok">sent</span>
              <% } else if (n.status === 'failed') { %><span class="badge bad">failed</span>
              <% } else { %><span class="badge info"><%= n.status %></span><% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
