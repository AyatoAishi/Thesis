<div class="page-head" style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap">
  <div>
    <h1>Reports</h1>
    <div class="sub">Seasonal trend — how many came, and what with</div>
  </div>
  <a class="mini-btn" href="/reports/trend?from=<%= from %>&to=<%= to %>&format=pdf" target="_blank">Export PDF</a>
</div>

<div class="card">
  <%- include("../partials/reports-tabbar", { active: "trend", from, to, period }) %>

  <%- include("../partials/reports-filter", { action: "/reports/trend", from, to, period }) %>

  <% if (!months.length) { %>
    <p class="muted" style="padding:8px 2px">No appointments in this range.</p>
  <% } else { %>
    <canvas id="trendChart" height="90" aria-label="Appointments per service per month" role="img"></canvas>
    <%# "<" escaped by hand — JSON.stringify leaves it, and a service name
        containing "</script>" would otherwise end this tag early. %>
    <script id="trendData" type="application/json"><%- JSON.stringify(chartData).replace(/</g, "\\u003c") %></script>

    <table class="tbl" style="margin-top:22px">
      <thead>
        <tr><th>Month</th><% services.forEach(s => { %><th><%= pretty(s.name) %></th><% }) %></tr>
      </thead>
      <tbody>
        <% months.forEach(m => { %>
          <tr>
            <td class="mono"><%= m %></td>
            <% services.forEach(s => { %><td><%= (grid[s.service_id] && grid[s.service_id][m]) || 0 %></td><% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="muted" style="font-size:12px;margin-top:10px">Appointment volume per service, grouped by month — the table above is always accurate; the chart needs an internet connection to load Chart.js.</p>
  <% } %>
</div>

<%# The second question on this page. Appointments say a person was expected;
    consultations say what was actually wrong with them, which is the half that
    can show a cold-weather spike. Kept as its own card so the two are never
    read as one number. %>
<div class="card">
  <div class="panel-title" style="margin-bottom:4px">What they came in with</div>
  <p class="muted" style="font-size:12.5px;margin:0 0 14px">
    Counted from consultation records, not appointments — one row per patient actually seen.
  </p>

  <% if (!illMonths.length) { %>
    <p class="muted" style="padding:8px 2px">
      No consultations recorded in this range. Illnesses are counted from the
      <b>What they came in with</b> field on a consultation record, so this fills in as
      staff record visits.
    </p>
  <% } else { %>
    <canvas id="illnessChart" height="90" aria-label="Consultations per illness per month" role="img"></canvas>
    <script id="illnessData" type="application/json"><%- JSON.stringify(illChartData).replace(/</g, "\\u003c") %></script>

    <table class="tbl" style="margin-top:22px">
      <thead>
        <tr><th>Illness</th><% illMonths.forEach(m => { %><th class="mono"><%= m %></th><% }) %><th>Total</th></tr>
      </thead>
      <tbody>
        <% illnesses.forEach(name => { %>
          <tr>
            <td><%= name %></td>
            <% illMonths.forEach(m => { %><td><%= (illGrid[name] && illGrid[name][m]) || 0 %></td><% }) %>
            <td><b><%= illTotals[name] %></b></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="muted" style="font-size:12px;margin-top:10px">
      Ordered by how much of this range each illness accounts for.
      <b>Not recorded</b> counts consultations written before this field existed, or left blank.
    </p>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script>
  (function () {
    var el = document.getElementById("trendData");
    var canvas = document.getElementById("trendChart");
    if (!el || !canvas || typeof Chart === "undefined") return;
    var data = JSON.parse(el.textContent);
    new Chart(canvas.getContext("2d"), {
      type: "bar",
      data: data,
      options: { responsive: true, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } },
    });
  })();

  // A line per illness rather than bars: the point of this one is the SHAPE
  // across the months — which curve climbs when the weather turns — and twenty
  // stacked bars per month hide exactly that.
  (function () {
    var el = document.getElementById("illnessData");
    var canvas = document.getElementById("illnessChart");
    if (!el || !canvas || typeof Chart === "undefined") return;
    new Chart(canvas.getContext("2d"), {
      type: "line",
      data: JSON.parse(el.textContent),
      options: {
        responsive: true,
        interaction: { mode: "index", intersect: false },
        elements: { line: { tension: 0.3 } },
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
      },
    });
  })();
</script>
